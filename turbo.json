{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "remoteCache": {
    "signature": true
  },
  "globalPassThroughEnv": [
    "ADMINER_URL",
    "ADMIN_SECRET",
    "AGENT_MEMORY_JOB_BEARER_TOKEN",
    "AI_GATEWAY_API_KEY",
    "APP_TIMEZONE",
    "APP_VERSION",
    "BACKUP_DIR",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BROWSERLESS_API_KEY",
    "CALENDAR_API_BEARER_TOKEN",
    "CARGO_HOME",
    "CLOUD_ADMIN_URL",
    "COOKIE_DOMAIN",
    "COHERE_API_KEY",
    "DATABASE_CREDENTIAL_ENCRYPTION_KEY",
    "DATABASE_URL",
    "DB_POOL_MAX",
    "DISK_MIN_HEADROOM_PERCENT",
    "DOCKER_HOST",
    "DRAFT_ID",
    "NEXT_PUBLIC_DISK_BAY_COUNT",
    "EMAIL_CLASSIFIER_API_TOKEN",
    "EMAIL_CLASSIFIER_TIMEOUT_MS",
    "EMAIL_CLASSIFIER_URL",
    "EMAIL_JOB_BEARER_TOKEN",
    "ENABLE_BANKING_APPLICATION_ID",
    "ENABLE_BANKING_PRIVATE_KEY_B64",
    "ENVOY_CRON_SECRET",
    "ENVOY_DATABASE_URL",
    "ENVOY_GITHUB_CLIENT_ID",
    "ENVOY_GITHUB_CLIENT_SECRET",
    "ENVOY_S3_ACCESS_KEY_ID",
    "ENVOY_S3_BUCKET",
    "ENVOY_S3_ENDPOINT",
    "ENVOY_S3_REGION",
    "ENVOY_S3_SECRET_ACCESS_KEY",
    "EVENTS_SLACK_WEBHOOK_URL",
    "FINANCE_ENCRYPTION_KEY",
    "FINANCE_BASE_CURRENCY",
    "GITHUB_TOKEN",
    "GOOGLE_CALENDAR_REDIRECT_URI",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "HDD_DEVICES",
    "HDD_STORAGE_PATH",
    "HEALTH_CHECK_BEARER_TOKEN",
    "IMAP_ENCRYPTION_KEY",
    "INSTAGRAM_ACCESS_TOKEN",
    "INSTAGRAM_APP_ID",
    "INSTAGRAM_APP_SECRET",
    "INSTAGRAM_REDIRECT_URI",
    "JWT_SECRET",
    "LATEX_INLINE_MODEL",
    "LATEX_TECTONIC_PATH",
    "MEILISEARCH_ADMIN_KEY",
    "MEILISEARCH_URL",
    "MEILI_MASTER_KEY",
    "METRICS_NOTIFICATION_WEBHOOK_URL",
    "MICROSD_DEVICE",
    "MONGODB_ADMIN_URI",
    "MONGODB_CONTAINER",
    "MONGODB_EXTERNAL_HOST",
    "MONGODB_INTERNAL_HOST",
    "MONGODB_URI",
    "MONGOT_HEALTH_URL",
    "MONGOT_MAX_INDEXES_PER_PROJECT",
    "MONGO_EXPRESS_URL",
    "MONGO_RESOURCE_URI",
    "OPENALEX_API_KEY",
    "OPENAI_API_KEY",
    "PGCONNECT_TIMEOUT",
    "POSTGRES_CONTAINER",
    "POSTGRES_EXTERNAL_HOST",
    "POSTGRES_INTERNAL_HOST",
    "REBOOT_SENTINEL_PATH",
    "REDIS_ADMIN_URL",
    "REDIS_EXTERNAL_HOST",
    "REDIS_INTERNAL_HOST",
    "RESEND_API_KEY",
    "REVALIDATE_SECRET",
    "RUSTUP_HOME",
    "R2_ACCESS_KEY_ID",
    "R2_ACCOUNT_ID",
    "R2_BUCKET",
    "R2_SECRET_ACCESS_KEY",
    "S3_ACCESS_KEY_ID",
    "S3_CREDENTIAL_ENCRYPTION_KEY",
    "S3_REGION",
    "S3_ROOT_PATH",
    "S3_SECRET_ACCESS_KEY",
    "S3_TEMP_PATH",
    "SEMANTIC_SCHOLAR_API_KEY",
    "SESSION_IDLE_HOURS",
    "SLACK_COMMENTS_WEBHOOK_URL",
    "SLACK_WEBHOOK_URL",
    "SSD_DEVICE",
    "SSD_STORAGE_PATH",
    "STORAGE_FILE_UPLOAD_PATH",
    "STORAGE_IMAGE_UPLOAD_PATH",
    "STORAGE_S3_ACCESS_KEY_ID",
    "STORAGE_S3_BUCKET",
    "STORAGE_S3_ENDPOINT",
    "STORAGE_S3_REGION",
    "STORAGE_S3_SECRET_ACCESS_KEY",
    "STORAGE_SPREADSHEET_UPLOAD_PATH",
    "TEMP_UPLOAD_PATH",
    "TERMINAL_API_URL",
    "TERMINAL_COOKIE",
    "TERMINAL_SERVER_URL",
    "TERMINAL_TICKET_SECRET",
    "TMUX_SOCKET_NAME",
    "TODAY_BOARD_RESET_JOB_TOKEN",
    "TOTP_ENCRYPTION_KEY",
    "TRANSFORMERS_CACHE_DIR",
    "TRANSFORMERS_ENTRY_PATH",
    "TRIAGE_JOB_BEARER_TOKEN",
    "TUNNEL_HEALTH_URL",
    "VERCEL_OIDC_TOKEN",
    "VERCEL_URL",
    "VOICE_TRANSCRIPTION_MODEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_CLOUD_API_URL",
        "NEXT_PUBLIC_DISK_BAY_COUNT",
        "NEXT_PUBLIC_DESKTOP_API_BASE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_STORAGE_APP_URL"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "out/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "env": ["LLM_LIVE_TESTS", "OPS_PROFILE_SAMPLES", "RUN_CLOUD_INFRA_TESTS"],
      "passThroughEnv": [
        "AUTH_MIGRATION_REPORT_KEY",
        "CLOUD_AUTH_FLOW_TEST_DATABASE_URL",
        "CLOUD_AUTH_TEST_DATABASE_URL",
        "CLOUD_AUTH_TEST_REDIS_URL",
        "CLOUD_TEST_DATABASE_URL",
        "CLOUD_TEST_DOCKER_HOST",
        "CLOUD_TEST_MEILISEARCH_URL",
        "CLOUD_TEST_MEILI_MASTER_KEY",
        "CLOUD_TEST_MONGODB_ADMIN_URI",
        "CLOUD_TEST_REDIS_ADMIN_URL",
        "OPS_SMOKE_DATABASE_URL",
        "OPS_SMOKE_PASSWORD",
        "S3_SMOKE_DELETE_BUCKET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_CLOUD_API_URL",
        "NEXT_PUBLIC_DISK_BAY_COUNT",
        "NEXT_PUBLIC_DESKTOP_API_BASE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_STORAGE_APP_URL"
      ]
    },
    "//#format-and-lint": {},
    "//#format-and-lint:fix": {
      "cache": false
    }
  }
}
