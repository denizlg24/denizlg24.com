# =============================================================================
# denizlg24.com — root env
#
# Loaded by every root script via `bun --env-file=.env turbo run <task>`.
# Copy to `.env` and fill in. Anything with a default here can be omitted.
#
# Dev ports (see each app's `dev` script):
#   3000 web   3001 api   3002 cloud   3003 terminal   3004 desktop
#   3005 storage   3006 envoy
# =============================================================================


# -----------------------------------------------------------------------------
# Shared — public URLs inlined at build time.
# Changing any of these busts the build cache (turbo.json tasks.build.env).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://denizlg24.com
NEXT_PUBLIC_SITE_URL=https://denizlg24.com
# Minimum number of hot-swap bays rendered by apps/cloud. All discovered disks
# are always shown even when this value is smaller than the disk count.
NEXT_PUBLIC_DISK_BAY_COUNT=12
# apps/desktop → apps/web admin API
NEXT_PUBLIC_DESKTOP_API_BASE_URL=http://localhost:3000/api/admin
# apps/cloud + apps/storage → apps/api
NEXT_PUBLIC_CLOUD_API_URL=http://localhost:3001
NEXT_PUBLIC_STORAGE_APP_URL=http://localhost:3005


# =============================================================================
# apps/envoy — public CLI site + API (PostgreSQL + denizlg24 cloud S3)
#
# Create an Envoy project in cloud.denizlg24.com, provision an S3 credential
# scoped to that project, and create a bucket matching the project slug.
# =============================================================================

ENVOY_DATABASE_URL=
ENVOY_GITHUB_CLIENT_ID=
ENVOY_GITHUB_CLIENT_SECRET=
ENVOY_CRON_SECRET=
ENVOY_S3_ENDPOINT=https://api.denizlg24.com/v2
ENVOY_S3_REGION=eu-west-1
ENVOY_S3_ACCESS_KEY_ID=
ENVOY_S3_SECRET_ACCESS_KEY=
ENVOY_S3_BUCKET=


# =============================================================================
# apps/macros — nutrition tracker (external PostgreSQL + Forge)
# =============================================================================

MACROS_DATABASE_URL=
MACROS_BETTER_AUTH_SECRET=
MACROS_BETTER_AUTH_URL=http://localhost:3000
MACROS_BETTER_AUTH_SECURE_COOKIES=false
MACROS_CRON_SECRET=
MACROS_VISION_URL=
MACROS_VISION_API_TOKEN=
EMAIL_FROM="Macros <noreply@denizlg24.com>"
NUTRITION_API_BASE_URL=https://nutrition.denizlg24.com
NUTRITION_API_KEY=

# Temporary read fallback and migration source for the previous Cloudflare R2
# deployment. Configure all four together until `storage:migrate:r2 --execute`
# has copied every object, then remove them.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=


# =============================================================================
# apps/web — portfolio + admin dashboard (MongoDB)
# =============================================================================

MONGODB_URI=
MONGO_RESOURCE_URI=
APP_TIMEZONE=Europe/Lisbon

# better-auth for the WEB app. apps/api reads the same variable name, so run
# it against its own .env when the two need different values.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

ADMIN_SECRET=
REVALIDATE_SECRET=
IMAP_ENCRYPTION_KEY=
# 32-byte hex key for encrypted bank session references.
FINANCE_ENCRYPTION_KEY=
ENABLE_BANKING_APPLICATION_ID=
# Base64-encoded PKCS#8 PEM (`BEGIN PRIVATE KEY`).
ENABLE_BANKING_PRIVATE_KEY_B64=
FINANCE_BASE_CURRENCY=EUR

# Markets (stock analyser + virtual portfolios)
# Tiingo meters per key. The relay reads numbered suffixes until one is missing
# and rotates to the next when Tiingo rejects one.
TIINGO_API_KEY=
TIINGO_API_KEY_2=
# SEC rejects EDGAR requests without a contact address, e.g.
# "denizlg24 deniz@denizlg24.com".
SEC_EDGAR_USER_AGENT=
# Optional: symbol search, profiles, logos, news, earnings calendar.
FINNHUB_API_KEY=
# Free-tier guardrails. The budget ledger refuses provider calls past these and
# serves cached data marked stale.
TIINGO_DAILY_BUDGET=1000
TIINGO_HOURLY_BUDGET=50
MARKETS_BASE_CURRENCY=USD
# Shared with apps/markets-relay; signs short-lived browser WebSocket tokens.
MARKETS_RELAY_TOKEN_SECRET=
# Unset falls back to polling the batched quotes route.
NEXT_PUBLIC_MARKETS_RELAY_URL=

# Cron / job bearer tokens
AGENT_MEMORY_JOB_BEARER_TOKEN=
CRON_SECRET=
CALENDAR_API_BEARER_TOKEN=
EMAIL_JOB_BEARER_TOKEN=
HEALTH_CHECK_BEARER_TOKEN=
# Accepted by /api/jobs/markets alongside CRON_SECRET. Nothing refreshes candles,
# quotes, fundamentals or portfolio snapshots unless that route is scheduled.
MARKETS_JOB_BEARER_TOKEN=
TODAY_BOARD_RESET_JOB_TOKEN=
TRIAGE_JOB_BEARER_TOKEN=

# LLM generation uses Vercel AI Gateway; voice transcription uses OpenAI directly.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
LATEX_INLINE_MODEL=
# Optional direct OpenAI transcription-model override.
VOICE_TRANSCRIPTION_MODEL=gpt-transcribe
COHERE_API_KEY=

# Third-party integrations
BROWSERLESS_API_KEY=
GITHUB_TOKEN=
OPENALEX_API_KEY=
RESEND_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
SLACK_WEBHOOK_URL=
SLACK_COMMENTS_WEBHOOK_URL=
EVENTS_SLACK_WEBHOOK_URL=

# Object storage for web uploads (distinct from the cloud S3 service below)
STORAGE_S3_ENDPOINT=https://api.denizlg24.com/v2
STORAGE_S3_REGION=eu-west-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_BUCKET=denizlg24-web

# Private Python email classifier.
EMAIL_CLASSIFIER_URL=https://classifier.denizlg24.com/api/classify
EMAIL_CLASSIFIER_API_TOKEN=
EMAIL_CLASSIFIER_TIMEOUT_MS=30000
STORAGE_IMAGE_UPLOAD_PATH=uploads/images
STORAGE_FILE_UPLOAD_PATH=uploads/files
STORAGE_SPREADSHEET_UPLOAD_PATH=spreadsheets
STORAGE_VOICE_UPLOAD_PATH=uploads/voice-notes

# CV compilation
LATEX_TECTONIC_PATH=

# Terminal panel in the web admin
TERMINAL_API_URL=http://localhost:3001
TERMINAL_COOKIE=


# =============================================================================
# apps/api — self-hosted cloud API (PostgreSQL)
# Prod values live in infra/compose/*.yml; these are dev defaults.
# =============================================================================

DATABASE_URL=postgres://denizcloud:devpassword@127.0.0.1:5433/denizcloud
DB_POOL_MAX=5
PGCONNECT_TIMEOUT=

COOKIE_DOMAIN=

MONGODB_ADMIN_URI=mongodb://denizcloud:devpassword@127.0.0.1:27018/admin?directConnection=true
REDIS_ADMIN_URL=redis://:devpassword@127.0.0.1:6380
MEILISEARCH_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=devmasterkey0000000000000000000000000000
MEILISEARCH_ADMIN_KEY=devmasterkey0000000000000000000000000000

# Encryption at rest
TOTP_ENCRYPTION_KEY=
DATABASE_CREDENTIAL_ENCRYPTION_KEY=
S3_CREDENTIAL_ENCRYPTION_KEY=
JWT_SECRET=

# Cloud S3 service
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=eu-west-1
S3_ROOT_PATH=
S3_TEMP_PATH=
S3_CREDENTIAL_CACHE_TTL_MS=30000
TEMP_UPLOAD_PATH=
SSD_STORAGE_PATH=
HDD_STORAGE_PATH=

# Cloud storage engine. Every value below has a working default; they are
# listed so the knobs are discoverable rather than because they must be set.
# STORAGE_ARCHIVE_MAX_BYTES caps a multi-select ZIP download — the storage app
# turns anything over it into a "download in smaller batches" message, and ZIP32
# cannot exceed 4095 MiB. Archives are staged in STORAGE_ARCHIVE_PATH (defaults
# to <SSD>/.archives) and swept STORAGE_ARCHIVE_TTL_MINUTES after they finish.
STORAGE_ARCHIVE_MAX_BYTES=2147483648
STORAGE_ARCHIVE_TTL_MINUTES=30
# Tiering: files move SSD -> HDD once usage crosses the high watermark, until
# it drops to the target. Only files older and larger than the minimums move,
# at most the batch cap per pass.
SSD_HIGH_WATERMARK_PERCENT=80
SSD_TARGET_WATERMARK_PERCENT=70
STORAGE_TIER_MIN_AGE_DAYS=30
STORAGE_TIER_MIN_SIZE_MIB=500
STORAGE_TIER_BATCH_CAP=20

# Addresses handed back to project clients
POSTGRES_INTERNAL_HOST=postgres:5432
POSTGRES_EXTERNAL_HOST=postgres.denizlg24.com:5433
MONGODB_INTERNAL_HOST=mongodb:27017
MONGODB_EXTERNAL_HOST=mongodb.denizlg24.com:27018
REDIS_INTERNAL_HOST=redis:6379
REDIS_EXTERNAL_HOST=redis.denizlg24.com:6380
MONGOT_HEALTH_URL=http://mongot:8080
MONGOT_MAX_INDEXES_PER_PROJECT=5

# Ops plane
APP_VERSION=
CLOUD_ADMIN_URL=http://localhost:3002
FORGE_URL=http://localhost:3006
DOCKER_HOST=tcp://127.0.0.1:23750
POSTGRES_CONTAINER=postgres
MONGODB_CONTAINER=mongodb
ADMINER_URL=http://127.0.0.1:8081
MONGO_EXPRESS_URL=http://127.0.0.1:8082
BACKUP_DIR=/backups
REBOOT_SENTINEL_PATH=/host-control/reboot-requested
TUNNEL_HEALTH_URL=
METRICS_NOTIFICATION_WEBHOOK_URL=
DISK_MIN_HEADROOM_PERCENT=10
SSD_DEVICE=
HDD_DEVICES=
MICROSD_DEVICE=


# =============================================================================
# apps/terminal — tmux-backed terminal service (loopback only, port 3003)
# =============================================================================

TERMINAL_SERVER_URL=ws://127.0.0.1:3003
TERMINAL_TICKET_SECRET=replace-with-the-same-random-secret-as-the-api
TMUX_SOCKET_NAME=cloud-terminal
SESSION_IDLE_HOURS=24


# =============================================================================
# Forge deploy platform — the control plane half, read by apps/api.
# Both DEPLOY_AGENT_* must be set or /api/deploy is not mounted at all.
# =============================================================================

DEPLOY_AGENT_URL=
DEPLOY_AGENT_TOKEN=
# Its own key, deliberately not S3_CREDENTIAL_ENCRYPTION_KEY: that one cannot
# change, and tying app env vars to it means never being able to rotate either.
DEPLOY_ENV_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
DEPLOY_S3_ENDPOINT=https://api.denizlg24.com/v2
DEPLOY_S3_REGION=auto
# Absent means a deployment still builds, runs and routes through Caddy with no
# public name.
FORGE_CLOUDFLARE_API_TOKEN=
FORGE_CLOUDFLARE_ZONE_ID=
FORGE_CLOUDFLARE_ZONE_NAME=denizlg24.com
FORGE_TUNNEL_ID=
# All three or none. The private key is the PEM either verbatim with escaped
# newlines or base64 of the whole file.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# The app's URL slug (github.com/apps/<slug>). Only builds the install link;
# unset costs the connect button, not any API call.
GITHUB_APP_SLUG=


# =============================================================================
# apps/deploy-agent — the executor half. In production these live in
# /etc/forge/agent.env on the deploy host; `bun run dev` reads them from here.
# Everything below AGENT_TOKEN has a working default (the production one is
# shown); the values here are what a macOS dev box needs instead.
# =============================================================================

# Loopback, RFC1918, link-local or CGNAT only — a wildcard or public address is
# refused at startup rather than silently downgraded.
AGENT_BIND_ADDRESS=127.0.0.1
AGENT_PORT=4010
# >=32 chars, and equal to DEPLOY_AGENT_TOKEN above.
AGENT_TOKEN=
CONTROL_PLANE_URL=http://127.0.0.1:3001
MAX_CONCURRENT_BUILDS=1
# /srv/forge/{builds,logs,cache} and /run/forge in production.
BUILD_ROOT=
LOG_ROOT=
CACHE_ROOT=
RUN_ENV_ROOT=
DOCKER_SOCKET=/var/run/docker.sock
# statfs'd by /healthz. /var/lib/docker on the Pi; on macOS the daemon's root is
# inside the VM, so point this at the local data dir (e.g. ~/.orbstack).
DOCKER_DATA_ROOT=
# Production uses the managed external worker. Keep install serialization on
# for a rotational BuildKit data root; the SSD migration turns it off.
BUILDX_BUILDER=forge
BUILDKIT_ENDPOINT=
SERIALIZE_BUN_INSTALLS=true
# Created by hand: `docker network create forge-apps`.
DOCKER_NETWORK=forge-apps
# Refused at startup unless it points at loopback.
CADDY_ADMIN_URL=http://127.0.0.1:2019
CADDY_LISTEN=127.0.0.1:8080
CADDY_STATE_PATH=
BUILD_MEMORY_LIMIT_MB=6144
# Excluded from deploy capacity for the OS, Docker, Caddy and the agent.
MEMORY_HEADROOM_MB=1024
HEALTH_POLL_MS=2000
CONTAINER_DRAIN_MS=10000
CLAIM_POLL_MS=3000
HEARTBEAT_MS=30000


# =============================================================================
# Tooling — turbo, Vercel, Tauri
# CARGO_HOME / RUSTUP_HOME are passed through for apps/desktop Tauri builds.
# =============================================================================

TURBO_REMOTE_CACHE_SIGNATURE_KEY=
TRANSFORMERS_CACHE_DIR=
TRANSFORMERS_ENTRY_PATH=
# VERCEL_URL / VERCEL_OIDC_TOKEN / DRAFT_ID are injected by Vercel at runtime;
# they are listed in turbo.json passthrough but should stay unset locally.
VERCEL_OIDC_TOKEN=


# =============================================================================
# Tests — opt-in only. Integration suites skip themselves when unset.
# =============================================================================

RUN_CLOUD_INFRA_TESTS=
LLM_LIVE_TESTS=
CLOUD_TEST_DATABASE_URL=
CLOUD_TEST_MONGODB_ADMIN_URI=
CLOUD_TEST_REDIS_ADMIN_URL=
CLOUD_TEST_MEILISEARCH_URL=
CLOUD_TEST_MEILI_MASTER_KEY=
CLOUD_TEST_DOCKER_HOST=
CLOUD_AUTH_TEST_DATABASE_URL=
CLOUD_AUTH_TEST_REDIS_URL=
CLOUD_AUTH_FLOW_TEST_DATABASE_URL=
OPS_SMOKE_DATABASE_URL=
OPS_SMOKE_PASSWORD=
OPS_PROFILE_SAMPLES=
S3_SMOKE_DELETE_BUCKET=
AUTH_MIGRATION_REPORT_KEY=
# Macros app
MACROS_S3_ENDPOINT=https://api.denizlg24.com/v2
MACROS_S3_REGION=eu-west-1
MACROS_S3_ACCESS_KEY_ID=
MACROS_S3_SECRET_ACCESS_KEY=
MACROS_VISION_TIMEOUT_MS=15000
