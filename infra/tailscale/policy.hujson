// Tailnet policy. Paste into the Tailscale admin console (Access Controls).
// Kept here so a change to who can reach the deploy agent is reviewable in the
// same place as the code that assumes it.
{
    "tagOwners": {
        "tag:ci": ["denizlg24@github"],
        "tag:pi": ["denizlg24@github"],
        // The deploy host. Tagged rather than user-owned so its node key does
        // not expire: a user-owned node drops off the tailnet after 180 days,
        // which on a build host means deploys stop with no code change to
        // explain it.
        "tag:forge": ["denizlg24@github"],
        // Short-lived combined recovery host. The OAuth client used by the
        // recovery command is scoped to this tag and auth_keys only.
        "tag:dr": ["denizlg24@github"],
    },

    "grants": [
        {
            "src": ["denizlg24@github"],
            // tag:forge is listed explicitly because tagging the node takes it
            // out of autogroup:self. Without this line, tagging forge is the
            // moment admin SSH to it stops working.
            "dst": ["autogroup:self", "tag:pi", "tag:forge", "tag:dr"],
            "ip":  ["tcp:22", "tcp:445"],
        },
        {
            "src": ["tag:dr"],
            "dst": ["tag:dr"],
            "ip":  ["*"],
        },
        {
            // Split-host recovery: DR claims from Pi, while Pi proxies owner
            // operations to the recovered Forge agent.
            "src": ["tag:dr"],
            "dst": ["tag:pi"],
            "ip":  ["tcp:3001"],
        },
        {
            // Pi-only recovery: the recovered control plane still proxies
            // owner operations to the surviving Forge agent.
            "src": ["tag:dr"],
            "dst": ["tag:forge"],
            "ip":  ["tcp:4010"],
        },
        {
            "src": ["tag:pi"],
            "dst": ["tag:dr"],
            "ip":  ["tcp:4010"],
        },
        {
            // Pi-only recovery: the surviving Forge agent claims work from
            // the recovered control plane.
            "src": ["tag:forge"],
            "dst": ["tag:dr"],
            "ip":  ["tcp:3001"],
        },
        {
            "src": ["denizlg24@github"],
            "dst": ["192.168.1.0/24"],
            "ip":  ["*"],
        },
        {
            "src": ["tag:ci"],
            "dst": ["tag:pi"],
            "ip":  ["tcp:22"],
        },
        {
            // The agent claiming work. This is the hot path and it is
            // agent-initiated: nothing pushes a build, the agent polls
            // POST /api/deploy/agent/claim every few seconds. Easy to get
            // backwards, because the control plane is the thing being
            // "deployed from" — but it is the destination here, not the source.
            "src": ["tag:forge"],
            "dst": ["tag:pi"],
            "ip":  ["tcp:3001"],
        },
        {
            // The other direction, for the owner-initiated operations the
            // control plane proxies to a running deployment: log streaming,
            // cancel, restart. Not needed to build anything.
            "src": ["tag:pi"],
            "dst": ["tag:forge"],
            "ip":  ["tcp:4010"],
        },
        {
            // CI: 22 to stage the binary and run the install script, 4010 for
            // the health gate that follows the restart.
            "src": ["tag:ci"],
            "dst": ["tag:forge"],
            "ip":  ["tcp:22", "tcp:4010"],
        },
    ],

    "ssh": [
        {
            "action":      "check",
            "checkPeriod": "12h",
            "src":         ["denizlg24@github"],
            "dst":         ["autogroup:self"],
            "users":       ["denizlg24"],
        },
        {
            "action":      "check",
            "checkPeriod": "12h",
            "src":         ["denizlg24@github"],
            "dst":         ["tag:pi"],
            "users":       ["denizlg24"],
        },
        {
            "action":      "check",
            "checkPeriod": "12h",
            "src":         ["denizlg24@github"],
            "dst":         ["tag:forge"],
            "users":       ["denizlg24"],
        },
        {
            "action":      "check",
            "checkPeriod": "12h",
            "src":         ["denizlg24@github"],
            "dst":         ["tag:dr"],
            "users":       ["root"],
        },
        {
            // Unattended, so accept rather than check — a workflow cannot
            // satisfy a re-authentication prompt.
            "action": "accept",
            "src":    ["tag:ci"],
            "dst":    ["tag:pi"],
            "users":  ["denizlg24"],
        },
        {
            "action": "accept",
            "src":    ["tag:ci"],
            "dst":    ["tag:forge"],
            "users":  ["denizlg24"],
        },
    ],
}
