[Unit]
Description=Privileged namespace metadata service for the Deniz Cloud API
Requires=deniz-cloud-storage-namespace.service
After=deniz-cloud-storage-namespace.service
# Before smbd too: the SMB unit's ExecStartPre validates the rendered API
# service, which requires the metadata socket to already exist. It also has to
# exist before Docker starts the API, or Docker creates a directory at the
# socket path and the bind mount silently becomes useless.
Before=deniz-cloud-storage-smb.service deniz-cloud-storage-api-broker.service deniz-cloud-storage-watchdog.service
PartOf=deniz-cloud-storage.target

[Service]
Type=simple
# Root is the point: this is the only component permitted to read or write
# security.denizcloud.* xattrs. It never serves bytes and never listens on a
# network socket.
User=root
EnvironmentFile=/etc/deniz-cloud/posix-storage.env
EnvironmentFile=/etc/deniz-cloud/storage-metadata.env
RuntimeDirectory=deniz-cloud
RuntimeDirectoryMode=0755
# The API bind-mounts this directory to reach the socket, and a bind mount
# follows the inode rather than the path. The default would delete the
# directory on every stop and recreate it with a new inode, leaving the
# container holding the old unlinked one: the socket then appears missing
# inside the container and only inside it, while the service looks healthy and
# /healthz — which never touches the socket — keeps reporting healthy. The
# breakage lasts until something recreates the container, so it outlives the
# restart that caused it.
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/bin/cloud-storage-metadata
Restart=on-failure
RestartSec=2
UMask=0007
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
LimitNOFILE=8192

[Install]
WantedBy=deniz-cloud-storage.target
