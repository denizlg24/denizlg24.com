[Unit]
Description=Restrict the Gate1B storage broker SMB socket to loopback
Requires=deniz-cloud-storage-namespace.service
# After= alone does not pull network-online.target into the transaction, so
# without Wants= the ordering silently has no effect.
Wants=network-online.target
After=deniz-cloud-storage-namespace.service network-online.target tailscaled.service
Before=deniz-cloud-storage-smb.service
PartOf=deniz-cloud-storage.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/deniz-cloud/posix-storage-host.sh --execute firewall-start
ExecStop=/usr/local/lib/deniz-cloud/posix-storage-host.sh --execute firewall-stop
# Must exceed the script's own 90s wait for the tailscale0 address, or systemd
# kills the wait it was given to do and the boot race comes back.
TimeoutStartSec=120
TimeoutStopSec=30
