[Unit]
Description=Forge deploy agent
After=network-online.target tailscaled.service docker.service forge-buildkit.service
Wants=network-online.target
Requires=docker.service forge-buildkit.service
RequiresMountsFor=/mnt/storage/forge/builds /mnt/storage/forge/logs /mnt/storage/forge/cache
ConditionPathIsMountPoint=/mnt/storage

[Service]
Type=simple
# Unprivileged, unlike cloud-terminal. The agent shells out to docker, git and
# nixpacks and never needs root itself — docker group membership is what lets
# it reach the socket. That membership is root-equivalent in practice (anyone
# who can talk to the socket can mount / into a container), so `forge` is a
# dedicated account with no shell and no sudo rather than a human's login.
User=forge
Group=forge
SupplementaryGroups=docker
EnvironmentFile=/etc/forge/agent.env

# AGENT_BIND_ADDRESS is a Tailscale address, and `After=tailscaled.service`
# only orders against the daemon starting — not against it having finished
# authenticating and brought the interface up. Binding an address that does not
# exist yet fails immediately, so at boot the agent would otherwise burn its
# five default restarts inside fifteen seconds and stay dead until someone
# noticed. Waiting is quieter than crash-looping, and bounded so a genuinely
# wrong address still fails instead of hanging the boot forever.
ExecStartPre=/bin/bash -c 'for _ in $(seq 1 90); do ip -4 -o addr show | grep -qF "$AGENT_BIND_ADDRESS" && exit 0; sleep 1; done; echo "AGENT_BIND_ADDRESS $AGENT_BIND_ADDRESS never appeared on any interface" >&2; exit 1'
ExecStart=/usr/local/bin/forge-agent

# `always`, not `on-failure`: a clean exit is not a reason for the deploy agent
# to stay down either.
Restart=always
RestartSec=5s
# No rate limit. The failure that matters here is transient and external — the
# tailnet, the control plane, the docker socket — and a unit that gives up
# after five tries turns a thirty-second outage into an indefinite one.
StartLimitIntervalSec=0
TimeoutStartSec=120

# /run/forge, as tmpfs, wiped on every restart. A resolved env set no longer
# touches the filesystem at all — it is passed to `docker run` as argv — so
# nothing sensitive lands here now. Kept because the unit's other paths assume
# a private runtime directory exists.
RuntimeDirectory=forge
RuntimeDirectoryMode=0700
WorkingDirectory=/srv/forge

# Everything outside the build tree and the docker socket is off limits. The
# agent's whole job is running other people's code, so the blast radius of the
# supervisor itself is worth keeping small even though the containers it starts
# are not constrained by any of this.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/forge /mnt/storage/forge/builds /mnt/storage/forge/logs /mnt/storage/forge/cache
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
