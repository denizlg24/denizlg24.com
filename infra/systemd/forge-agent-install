#!/usr/bin/env bash
# Installs a staged forge-agent binary and restarts the service.
#
# The only thing `denizlg24` may run as root without a password. Scoping the
# sudoers rule to this script rather than to `install`, `mv` and `systemctl`
# is the point: NOPASSWD on those three is NOPASSWD on everything, since
# `install` can write any file anywhere.
#
# Root-owned, 0755, in a directory the deploy user cannot write. The staging
# path is fixed and owned by the deploy user, so CI can drop a binary there
# over SSH but cannot influence where it lands.

set -euo pipefail

STAGED=/var/lib/forge-agent/staging/forge-agent
TARGET=/usr/local/bin/forge-agent
PREVIOUS=/var/lib/forge-agent/forge-agent.prev
STAGING_DIR=/var/lib/forge-agent/staging
DR_RUNTIME="$STAGING_DIR/dr-runtime.tgz"
DR_HOST_CONFIG="$STAGING_DIR/forge.env"

install_dr_runtime() {
  local unpack
  [ -f "$DR_RUNTIME" ] && [ -s "$DR_RUNTIME" ] \
    || { echo "nothing staged at $DR_RUNTIME" >&2; exit 1; }

  # The archive is supplied by CI through a deploy-user-writable directory.
  # Accept only the reviewed runtime trees, reject links, and extract beneath a
  # private root-owned directory before publishing anything under /opt.
  tar -tzf "$DR_RUNTIME" | awk '
    /(^|\/)\.\.?($|\/)/ || /\/\// || /^\// { exit 1 }
    /^infra\/$/ { next }
    /^infra\/scripts\/$/ { next }
    /^infra\/dr\/$/ { next }
    /^infra\/dr\/[A-Za-z0-9._\/-]+$/ { next }
    /^infra\/scripts\/posix-namespace-(backup|restore-verify)\.sh$/ { next }
    { exit 1 }
  ' || { echo "staged DR runtime contains an unexpected path" >&2; exit 1; }
  tar -tvzf "$DR_RUNTIME" | awk '
    substr($0, 1, 1) != "-" && substr($0, 1, 1) != "d" { exit 1 }
  ' || { echo "staged DR runtime contains a non-file entry" >&2; exit 1; }
  unpack="$(mktemp -d /var/lib/forge-agent/dr-runtime.XXXXXX)"
  trap 'rm -rf -- "$unpack"' RETURN
  tar -xzf "$DR_RUNTIME" --no-same-owner --no-same-permissions -C "$unpack"
  if find "$unpack" -type l -print -quit | grep -q .; then
    echo "staged DR runtime contains a symbolic link" >&2
    exit 1
  fi

  install -d -m 0755 /opt/deniz-cloud/infra /opt/deniz-cloud/infra/scripts
  rm -rf -- /opt/deniz-cloud/infra/dr.new
  install -d -m 0755 /opt/deniz-cloud/infra/dr.new
  cp -a "$unpack/infra/dr/." /opt/deniz-cloud/infra/dr.new/
  chown -R root:root /opt/deniz-cloud/infra/dr.new
  if [ -e /opt/deniz-cloud/infra/dr ]; then
    rm -rf -- /opt/deniz-cloud/infra/dr.previous
    mv /opt/deniz-cloud/infra/dr /opt/deniz-cloud/infra/dr.previous
  fi
  mv /opt/deniz-cloud/infra/dr.new /opt/deniz-cloud/infra/dr
  install -m 0755 -o root -g root \
    "$unpack/infra/scripts/posix-namespace-backup.sh" \
    "$unpack/infra/scripts/posix-namespace-restore-verify.sh" \
    /opt/deniz-cloud/infra/scripts/
  if ! command -v restic >/dev/null 2>&1; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y restic
  fi
  rm -f -- "$DR_RUNTIME"
  rm -rf -- "$unpack"
  trap - RETURN
  echo "disaster-recovery runtime installed"
}

install_dr_host_config() {
  [ -f "$DR_HOST_CONFIG" ] && [ -s "$DR_HOST_CONFIG" ] \
    || { echo "nothing staged at $DR_HOST_CONFIG" >&2; exit 1; }
  [ -x /opt/deniz-cloud/infra/dr/install-host ] \
    || { echo "install the DR runtime first" >&2; exit 1; }
  install -d -m 0700 /etc/deniz-dr
  install -m 0600 -o root -g root "$DR_HOST_CONFIG" /etc/deniz-dr/forge.env
  rm -f -- "$DR_HOST_CONFIG"
  /opt/deniz-cloud/infra/dr/install-host \
    --profile forge --ssh-user denizlg24 --execute --defer-timers
}

if [ "${1:-}" = "--install-dr-runtime" ]; then
  [ "$#" -eq 1 ] || { echo "unexpected arguments" >&2; exit 2; }
  install_dr_runtime
  exit 0
fi
if [ "${1:-}" = "--install-dr-host-config" ]; then
  [ "$#" -eq 1 ] || { echo "unexpected arguments" >&2; exit 2; }
  install_dr_host_config
  exit 0
fi
[ "$#" -eq 0 ] || { echo "unexpected arguments" >&2; exit 2; }

[ -f "$STAGED" ] || { echo "nothing staged at $STAGED" >&2; exit 1; }
[ -s "$STAGED" ] || { echo "staged binary is empty" >&2; exit 1; }

buildkit_changed=0
if [ -f "$STAGING_DIR/forge-buildkit.service" ] \
  && ! cmp -s "$STAGING_DIR/forge-buildkit.service" \
    /etc/systemd/system/forge-buildkit.service; then
  buildkit_changed=1
fi
if [ -f "$STAGING_DIR/forge-buildkitd.toml" ] \
  && ! cmp -s "$STAGING_DIR/forge-buildkitd.toml" \
    /etc/forge/buildkitd.toml; then
  buildkit_changed=1
fi

# Restarting the agent cancels its in-memory queue, and restarting BuildKit
# additionally cancels every solve using it. A release must wait for both the
# build and post-build deployment phases to drain.
bind_address="$(awk -F= '$1 == "AGENT_BIND_ADDRESS" { print $2; exit }' /etc/forge/agent.env)"
agent_port="$(awk -F= '$1 == "AGENT_PORT" { print $2; exit }' /etc/forge/agent.env)"
agent_port="${agent_port:-4010}"
health="$(curl -sS --max-time 5 \
  "http://${bind_address}:${agent_port}/healthz" 2>/dev/null || true)"
if [ -n "$health" ] \
  && { ! grep -q '"running":0' <<<"$health" \
    || ! grep -q '"building":0' <<<"$health"; }; then
  echo "the Forge queue is not idle; refusing to cancel active deployments" >&2
  exit 1
fi

if pgrep -f 'docker-buildx.*buildx build|nixpacks build' >/dev/null; then
  echo "a build process is active; refusing to restart the Forge agent" >&2
  exit 1
fi

# A truncated scp produces a file that exists, is executable and dies at
# startup. Checking it runs before it becomes the service costs a second.
chmod 0755 "$STAGED"
if ! "$STAGED" --version >/dev/null 2>&1; then
  # The agent has no --version flag today; a non-zero exit from a missing flag
  # is fine, a signal or "cannot execute" is not. 126/127 are the shell's
  # "not executable" and "not found".
  status=$?
  if [ "$status" -ge 126 ]; then
    echo "staged binary is not executable on this host (exit $status)" >&2
    exit 1
  fi
fi

# Service definitions travel with the binary so a deploy cannot introduce a
# config field before the host knows how to provide it. Missing files are
# accepted for compatibility with older staged releases.
if [ -f "$STAGING_DIR/forge-agent.service" ]; then
  install -m 0644 -o root -g root \
    "$STAGING_DIR/forge-agent.service" /etc/systemd/system/forge-agent.service
  rm -f "$STAGING_DIR/forge-agent.service"
fi
if [ -f "$STAGING_DIR/forge-buildkit.service" ]; then
  install -m 0644 -o root -g root \
    "$STAGING_DIR/forge-buildkit.service" /etc/systemd/system/forge-buildkit.service
  rm -f "$STAGING_DIR/forge-buildkit.service"
fi
if [ -f "$STAGING_DIR/forge-buildkitd.toml" ]; then
  install -m 0644 -o root -g root \
    "$STAGING_DIR/forge-buildkitd.toml" /etc/forge/buildkitd.toml
  rm -f "$STAGING_DIR/forge-buildkitd.toml"
fi
if [ -f "$STAGING_DIR/forge-agent-install" ]; then
  install -m 0755 -o root -g root \
    "$STAGING_DIR/forge-agent-install" /usr/local/sbin/forge-agent-install
  rm -f "$STAGING_DIR/forge-agent-install"
fi

# Caddy's unit travels with the agent because the two are one contract: the agent
# publishes a config naming the access-log directory, and only `ReadWritePaths`
# in this unit lets Caddy open it. Out of step, Caddy rejects the *entire* config
# with a 400 — not just the logger — so every deployment stops routing while the
# agent's own /healthz stays green. They have to move together.
caddy_changed=0
if [ -f "$STAGING_DIR/forge-caddy.service" ]; then
  if ! cmp -s "$STAGING_DIR/forge-caddy.service" \
    /etc/systemd/system/forge-caddy.service; then
    caddy_changed=1
  fi
  install -m 0644 -o root -g root \
    "$STAGING_DIR/forge-caddy.service" /etc/systemd/system/forge-caddy.service
  rm -f "$STAGING_DIR/forge-caddy.service"
fi

# Root-created so it never depends on the agent having started first, and owned
# by the service user because both processes run as `forge`.
install -d -m 0750 -o forge -g forge /srv/forge/access

# The unprivileged agent and root-run DR backup coordinate every authoritative
# route/container mutation through this directory. Establish the service-group
# contract before installing a unit that names it in SupplementaryGroups.
getent group deniz-dr >/dev/null || groupadd --system deniz-dr
usermod -a -G deniz-dr forge
install -d -m 0750 -o root -g deniz-dr \
  /var/lib/deniz-dr /var/lib/deniz-dr/locks
setfacl -m g:deniz-dr:rwx,d:g:deniz-dr:rwx,d:m:rwx \
  /var/lib/deniz-dr/locks

systemctl daemon-reload
systemctl enable forge-buildkit.service >/dev/null
if [ "$buildkit_changed" = "1" ]; then
  systemctl restart forge-buildkit.service
fi

# Only when the unit actually changed. A sandbox property like ReadWritePaths
# applies at process start, so this needs a restart rather than a reload — and a
# restart drops Caddy to its bootstrap config until the agent republishes, which
# is a routing blip not worth taking on every agent release.
if [ "$caddy_changed" = "1" ]; then
  echo "forge-caddy.service changed; restarting Caddy"
  systemctl restart forge-caddy.service
fi

[ -f "$TARGET" ] && cp -f "$TARGET" "$PREVIOUS"

# rename(2), not a write. Overwriting a running executable in place fails with
# ETXTBSY; renaming over it leaves the old inode alive for the running process
# and is atomic for anything starting after. The worker is started first so a
# bad host migration leaves the current agent binary untouched and running.
install -m 0755 -o root -g root "$STAGED" "${TARGET}.new"
mv -f "${TARGET}.new" "$TARGET"
rm -f "$STAGED"

systemctl restart forge-agent.service

for _ in $(seq 1 30); do
  if systemctl is-active --quiet forge-agent; then
    # Active is not the same as serving; the caller still health-gates.
    echo "forge-agent restarted"
    exit 0
  fi
  sleep 1
done

echo "forge-agent did not become active; rolling back" >&2
if [ -f "$PREVIOUS" ]; then
  install -m 0755 -o root -g root "$PREVIOUS" "${TARGET}.new"
  mv -f "${TARGET}.new" "$TARGET"
  systemctl restart forge-agent || true
  echo "rolled back to the previous binary" >&2
fi
exit 1
