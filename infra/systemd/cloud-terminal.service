[Unit]
Description=deniz-cloud persistent terminal service
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# Operator decision: the web terminal is a full root shell. It is the primary
# way to administer this host from abroad, and a shell that could not sudo or
# read /home was not usable for that. The gate is the admin app — Better Auth
# session plus TOTP, then a single-use HMAC ticket. Anyone who defeats that has
# host root, so TERMINAL_ALLOW_ROOT must be set deliberately: the daemon
# refuses to start as uid 0 without it.
User=root
Group=root
Environment=HOME=/root
Environment=TMUX_TMPDIR=/var/lib/cloud-terminal
Environment=TERMINAL_ALLOW_ROOT=1
EnvironmentFile=/etc/deniz-cloud/terminal.env
ExecStart=/usr/local/bin/cloud-terminal
Restart=on-failure
RestartSec=3s
# Only the compiled daemon is stopped. The tmux server remains so sessions can
# be reattached after a daemon restart.
KillMode=process

StateDirectory=cloud-terminal
StateDirectoryMode=0700
RuntimeDirectory=cloud-terminal
RuntimeDirectoryMode=0700
WorkingDirectory=/root

# Sandboxing is deliberately minimal here: a root shell that cannot write the
# filesystem, see /home or gain privileges defeats the point of the feature.
# The listener restriction still applies — the service refuses to bind a
# publicly routable address (see apps/terminal/src/config.ts).
LockPersonality=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=0022

[Install]
WantedBy=multi-user.target
