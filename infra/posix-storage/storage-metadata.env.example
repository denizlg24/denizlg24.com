# Install as /etc/deniz-cloud/storage-metadata.env, root:root 0600.
# The namespace root and witness are the HOST paths, not the container's.
STORAGE_NAMESPACE_ROOT=/srv/deniz-cloud/storage
STORAGE_NAMESPACE_WITNESS_PATH_HOST=/srv/deniz-cloud/storage/.denizcloud-mount-witness
STORAGE_METADATA_SOCKET=/run/deniz-cloud/storage-metadata.sock
# Enables SMB account provisioning. Omit on a host that should not issue
# device credentials; the API then answers 503 rather than appearing to.
STORAGE_SMB_SCRIPT=/opt/deniz-cloud/infra/scripts/posix-smb-credential.sh
