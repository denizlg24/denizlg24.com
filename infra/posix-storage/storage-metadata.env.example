# Install as /etc/deniz-cloud/storage-metadata.env, root:root 0600.
# The namespace root and witness are the HOST paths, not the container's.
STORAGE_NAMESPACE_ROOT=/srv/deniz-cloud/storage
STORAGE_NAMESPACE_WITNESS_PATH_HOST=/srv/deniz-cloud/storage/.denizcloud-mount-witness
STORAGE_METADATA_SOCKET=/run/deniz-cloud/storage-metadata.sock
# Enables SMB account provisioning. Omit on a host that should not issue
# device credentials; the API then answers 503 rather than appearing to.
#
# Installed by hand, root-owned, outside the deploy tree — the same treatment
# as the metadata and terminal binaries. It runs as root, and the deploy tree
# is rewritten by an unattended release, so pointing this at a checkout would
# let a release change root-executed code as a side effect. The tarball ships
# it 0644 and non-executable, which would fail at call time anyway:
#   sudo install -D -m 0755 -o root -g root \
#     infra/scripts/posix-smb-credential.sh \
#     /usr/local/lib/deniz-cloud/posix-smb-credential.sh
STORAGE_SMB_SCRIPT=/usr/local/lib/deniz-cloud/posix-smb-credential.sh
