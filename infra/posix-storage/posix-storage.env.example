# Copy to /etc/deniz-cloud/posix-storage.env, replace every REQUIRED value,
# then keep the file root:root 0600. Device UUIDs are the ext4 filesystem UUIDs;
# branch IDs are the UUIDs recorded in each .denizcloud-branch.json marker.
DENIZ_POSIX_SSD_UUID=REQUIRED
DENIZ_POSIX_HDD_UUID=REQUIRED
DENIZ_POSIX_SSD_BRANCH_ID=REQUIRED
DENIZ_POSIX_HDD_BRANCH_ID=REQUIRED
DENIZ_POSIX_TAILSCALE_IP=100.89.155.9
DENIZ_POSIX_SSD_RESERVE=32G
# Checkpoint 2 is a broker-coherence pilot. Human shares remain `available=no`
# until the protected-metadata filter and per-device confinement gates pass.
DENIZ_POSIX_BOUNDARY_MODE=gate1b-pilot
STORAGE_NAMESPACE_WITNESS_PATH=/data/storage/.denizcloud-mount-witness
STORAGE_NAMESPACE_WITNESS_VALUE=REQUIRED
DENIZ_POSIX_COMPOSE_FILE=REQUIRED_ABSOLUTE_PATH_TO_docker-compose.pi.yml
DENIZ_POSIX_COMPOSE_OVERRIDE=REQUIRED_ABSOLUTE_PATH_TO_docker-compose.posix.yml
DENIZ_POSIX_COMPOSE_ENV=REQUIRED_ABSOLUTE_PATH_TO_.env.pi
