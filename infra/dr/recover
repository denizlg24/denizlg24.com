  activation_flag=""; [[ "$profile" == forge ]] && activation_flag="--defer-control-plane-activation"
  restore_forge_output="$(ssh "${ssh_opts[@]}" "$ssh_host" "'$remote_root/bin/restore-forge' --root '$remote_root/forge' --ghcr-auth '$remote_root/ghcr.auth' --api-token-file '$remote_root/api.token' --api-url '$api_url' --agent-url '$agent_url' $activation_flag")"
  restore_forge_result="$(tail -1 <<< "$restore_forge_output")"
  jq -e --argjson deferred "$([[ "$profile" == forge ]] && printf true || printf false)" '.restored==true and .expected>0 and .deploymentsRestored==.expected and
    .domainsVerified==.expected and .digestsVerified==.expected and .environmentsVerified==.expected and
    (.domains|length)==.expected and (.domains|unique|length)==.expected and
    (.activationMappings|length)==.expected and
    (if $deferred then .controlPlaneCommitted==false else .controlPlaneCommitted==true end) and
    (["forge-buildkit","forge-caddy","forge-agent"] - .servicesVerified | length)==0' <<< "$restore_forge_result" >/dev/null \
    || dr_die "Forge restore did not return complete digest/domain evidence"
  jq --argjson evidence "$restore_forge_result" \
    '.checks += [{name:"Forge immutable restore",status:"ok",detail:"every expected deployment digest, keyed environment semantic checksum, and local Caddy domain passed through the recovery agent",evidence:$evidence}] | .updatedAt=(now|todate)' \
    "$report" > "${report}.tmp" && mv -- "${report}.tmp" "$report"
  check_remote_headroom restore-forge
  finish_phase restore-forge
fi

if ! phase_done install-continuity; then
  begin_phase install-continuity
  tar --exclude='infra/dr/opentofu/.terraform' --exclude='*.tfstate' --exclude='*.tfstate.*' \
    -C "$repo_root" -cf - infra/dr \
    infra/scripts/posix-namespace-backup.sh infra/scripts/posix-namespace-restore-verify.sh \
    | ssh "${ssh_opts[@]}" "$ssh_host" 'install -d -m 0755 /opt/deniz-cloud/infra && tar -C /opt/deniz-cloud -xf -'
  continuity_command='set -e; getent group deniz-dr >/dev/null || groupadd --system deniz-dr; install -d -m 0750 -o root -g deniz-dr /var/lib/deniz-dr /var/lib/deniz-dr/repositories /var/lib/deniz-dr/ready /var/lib/deniz-dr/locks; install -d -m 0700 /var/lib/deniz-dr/staging /var/lib/deniz-dr/external-state /etc/deniz-dr; setfacl -m g:deniz-dr:rwx,d:g:deniz-dr:rwx,d:m:rwx /var/lib/deniz-dr/repositories /var/lib/deniz-dr/ready /var/lib/deniz-dr/locks; install -m 0644 /opt/deniz-cloud/infra/dr/systemd/deniz-dr-backup@.service /opt/deniz-cloud/infra/dr/systemd/deniz-dr-backup@.timer /opt/deniz-cloud/infra/dr/systemd/deniz-dr-heartbeat@.service /opt/deniz-cloud/infra/dr/systemd/deniz-dr-heartbeat@.timer /opt/deniz-cloud/infra/dr/systemd/deniz-dr-external-export.service /opt/deniz-cloud/infra/dr/systemd/deniz-dr-external-export.timer /etc/systemd/system/; systemctl daemon-reload'
  if [[ "$profile" == pi || "$profile" == all ]]; then
    continuity_command+='; systemctl disable --now deniz-dr-backup@pi.timer deniz-dr-heartbeat@pi.timer deniz-dr-external-export.timer 2>/dev/null || true'
  fi
  if [[ "$profile" == forge || "$profile" == all ]]; then
    continuity_command+='; id forge >/dev/null 2>&1; usermod -a -G deniz-dr forge; systemctl disable --now deniz-dr-backup@forge.timer deniz-dr-heartbeat@forge.timer 2>/dev/null || true'
  fi
  ssh "${ssh_opts[@]}" "$ssh_host" "$continuity_command"
  finish_phase install-continuity
fi

if ! phase_done remove-plaintext-staging; then
  begin_phase remove-plaintext-staging
  ssh "${ssh_opts[@]}" "$ssh_host" "rm -rf -- '$remote_root/pi-cloud' '$remote_root/forge'; rm -f -- '$remote_root/ghcr.auth' '$remote_root/api.token' '$remote_root/tailscale.key'; test ! -e '$remote_root/pi-cloud' && test ! -e '$remote_root/forge' && test ! -e '$remote_root/ghcr.auth' && test ! -e '$remote_root/api.token' && test ! -e '$remote_root/tailscale.key'"
  finish_phase remove-plaintext-staging
fi

if [[ "$no_cutover" == false ]]; then
  "$script_dir/cutover" --config "$config" --host "$target_host" --ssh-host "$ssh_host" --profile "$profile" --report "$report" --ssh-known-hosts "$known_hosts"
else
  jq '.result="verified-no-cutover" | .updatedAt=(now|todate)' "$report" > "${report}.tmp" && mv "${report}.tmp" "$report"
fi
collect_resource_metrics
dr_validate_json "$script_dir/schemas/recovery-report.schema.json" "$report"
dr_sign_file "$DR_COMPLETION_SIGNING_KEY" deniz-dr-recovery "$report" "${report}.sig"
"$script_dir/report" "$report" > "$report_dir/report.txt"
printf 'Recovery report: %s\n' "$report"
