#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
script_dir="$(cd "$(dirname "$0")" && pwd)"
source "$script_dir/lib/common.sh"
source "$script_dir/lib/telemetry.sh"
profile=""; mode=--check-only
while (($#)); do
  case "$1" in
    --profile) profile="${2:-}"; shift 2 ;;
    --execute|--check-only) mode="$1"; shift ;;
    *) echo 'Usage: r2-sync --profile pi|forge [--check-only|--execute]' >&2; exit 2 ;;
  esac
done
[[ "$profile" == pi || "$profile" == forge ]] || dr_die 'profile must be pi or forge'
host_name="$([[ "$profile" == pi ]] && printf pi-cloud || printf forge)"
lock_dir="${DR_REMOTE_ROOT:-/var/lib/deniz-dr}/locks/${host_name}.lock"
heartbeat() {
  local suffix="$1" url="${DR_R2_SYNC_HEARTBEAT_URL:-}"
  [[ -n "$url" ]] || return 0
  [[ "$url" == https://uptime.betterstack.com/* && "$url" != *[$'\r\n"\\']* ]] || return 1
  printf 'url = "%s%s"\nfail\nsilent\nshow-error\nmax-time = 15\n' "${url%/}" "$suffix" | curl --config - >/dev/null || true
}
if [[ "$mode" == --execute ]]; then
  if ! mkdir "$lock_dir" 2>/dev/null; then
    printf '%s\n' '{"phase":"skipped","reason":"host-lock-held"}' | dr_metrics
    echo '{"writes":false,"skipped":"host-lock-held"}'
    exit 0
  fi
  printf '%s\n' "$$" > "$lock_dir/pid"
  trap 'result=$?; dr_unlock "$lock_dir"; if ((result)); then heartbeat /fail; else heartbeat ""; fi' EXIT
fi
if [[ "$mode" == --execute ]]; then dr_phase offsite-copy; fi
python3 "$script_dir/lib/r2_sync.py" --profile "$profile" "$mode"
