#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

script_dir="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=../lib/common.sh
source "${script_dir}/../lib/common.sh"
config=""
while (($#)); do
  case "$1" in --config) config="${2:-}"; shift 2 ;; *) echo "Usage: install --config FILE" >&2; exit 2 ;; esac
done
[[ "$(uname -s)" == Darwin ]] || { echo "STOP: macOS is required" >&2; exit 1; }
[[ "$config" == /* && -f "$config" && ! -L "$config" ]] \
  || { echo "STOP: config must be an absolute path to a regular, non-symlink file" >&2; exit 1; }
[[ "$config" != *[$'\r\n\\<>&']* ]] || { echo "STOP: config path is unsafe for launchd XML" >&2; exit 1; }
mode="$(stat -f '%Lp' "$config")"
[[ "$mode" == 600 || "$mode" == 400 ]] || { echo "STOP: config must be mode 0600 or 0400" >&2; exit 1; }
# The directories these commands were actually found in become the agent's
# PATH. Checking them against the installing shell's PATH and then writing a
# plist with no PATH at all is a check that proves nothing: launchd starts an
# agent with /usr/bin:/bin:/usr/sbin:/sbin, so a Homebrew restic satisfies the
# check here and is missing every hour after. The hourly failure is silent
# where it matters — the cycle is the only thing that copies a backup offsite,
# so the first sign would have been the 12h iCloud heartbeat going off.
declared_path_dirs=()
for required_command in swiftc plutil launchctl jq ssh scp restic ssh-keygen curl find git tar zstd; do
  resolved="$(command -v "$required_command" 2>/dev/null)" \
    || { echo "STOP: required Mac recovery command is missing: ${required_command}" >&2; exit 1; }
  [[ "$resolved" == /* ]] \
    || { echo "STOP: required Mac recovery command is not an absolute path: ${required_command}" >&2; exit 1; }
  resolved_dir="$(dirname "$resolved")"
  [[ "$resolved_dir" != *[$'\r\n\\<>&:']* ]] \
    || { echo "STOP: command directory is unsafe for launchd XML: ${resolved_dir}" >&2; exit 1; }
  for seen in "${declared_path_dirs[@]:-}"; do
    [[ "$seen" != "$resolved_dir" ]] || continue 2
  done
  declared_path_dirs+=("$resolved_dir")
done
agent_path="$(
  IFS=:
  printf '%s' "${declared_path_dirs[*]}"
)"
for system_dir in /usr/bin /bin /usr/sbin /sbin; do
  case ":${agent_path}:" in *":${system_dir}:"*) ;; *) agent_path="${agent_path}:${system_dir}" ;; esac
done

install_root="${HOME}/Library/Application Support/deniz-dr"
log_root="${HOME}/Library/Logs/deniz-dr"
plist="${HOME}/Library/LaunchAgents/com.denizlg24.dr-sync.plist"
launch_agents="$(dirname "$plist")"
for managed_root in "$install_root" "$log_root" "$launch_agents"; do
  [[ "$managed_root" == /* && "$managed_root" != / && "$managed_root" != */ && "$managed_root" != *[$'\r\n\\<>&']* ]] \
    || dr_die "unsafe Mac installation path: ${managed_root}"
  dr_assert_managed_directory_path "$managed_root" "$managed_root"
done
for target in \
  "$install_root/macos/dr-sync" "$install_root/lib/common.sh" "$install_root/macos/dr-icloud-state" "$plist"; do
  [[ ! -L "$target" ]] || dr_die "refusing to replace a symlinked Mac installation target: ${target}"
done
dr_assert_managed_directory_path "$install_root" "$install_root/macos"
dr_assert_managed_directory_path "$install_root" "$install_root/lib"
dr_assert_managed_directory_path "$install_root" "$install_root/schemas"
if [[ -d "$install_root/schemas" ]]; then
  [[ -z "$(find "$install_root/schemas" -mindepth 1 -type l -print -quit)" ]] \
    || dr_die "refusing to install through a symlinked schema target"
fi
install -d -m 0700 "$install_root" "$log_root" "$(dirname "$plist")"
install -d -m 0700 "$install_root/macos" "$install_root/lib" "$install_root/schemas"
dr_assert_managed_directory_path "$install_root" "$install_root/macos"
dr_assert_managed_directory_path "$install_root" "$install_root/lib"
dr_assert_managed_directory_path "$install_root" "$install_root/schemas"
install -m 0700 "$script_dir/dr-sync" "$install_root/macos/dr-sync"
install -m 0600 "$script_dir/../lib/common.sh" "$install_root/lib/common.sh"
install -m 0600 "$script_dir/../schemas/"*.json "$install_root/schemas/"
binary_tmp="$(mktemp "$install_root/macos/dr-icloud-state.XXXXXX")"
swiftc -O "$script_dir/dr-icloud-state.swift" -o "$binary_tmp"
mv -f -- "$binary_tmp" "$install_root/macos/dr-icloud-state"
chmod 0700 "$install_root/macos/dr-icloud-state"

escaped_install="${install_root//&/\\&}"; escaped_install="${escaped_install//|/\\|}"
escaped_config="${config//&/\\&}"; escaped_config="${escaped_config//|/\\|}"
escaped_log="${log_root//&/\\&}"; escaped_log="${escaped_log//|/\\|}"
escaped_agent_path="${agent_path//&/\\&}"; escaped_agent_path="${escaped_agent_path//|/\\|}"
plist_tmp="$(mktemp "${launch_agents}/com.denizlg24.dr-sync.XXXXXX.plist")"
sed -e "s|__INSTALL_ROOT__|$escaped_install|g" -e "s|__CONFIG_PATH__|$escaped_config|g" -e "s|__LOG_ROOT__|$escaped_log|g" \
  -e "s|__AGENT_PATH__|$escaped_agent_path|g" \
  "$script_dir/com.denizlg24.dr-sync.plist.in" > "$plist_tmp"
plutil -lint "$plist_tmp" >/dev/null
mv -f -- "$plist_tmp" "$plist"
chmod 0600 "$plist"
launchctl bootout "gui/$(id -u)/com.denizlg24.dr-sync" >/dev/null 2>&1 || true
launchctl bootstrap "gui/$(id -u)" "$plist"
printf 'Installed hourly DR sync: %s\n' "$plist"
