#!/usr/bin/env bash

set -Eeuo pipefail
plist="${HOME}/Library/LaunchAgents/com.denizlg24.dr-sync.plist"
launchctl bootout "gui/$(id -u)/com.denizlg24.dr-sync" >/dev/null 2>&1 || true
if [[ -f "$plist" ]]; then
  trash="${HOME}/.Trash/com.denizlg24.dr-sync.plist.$(date +%Y%m%dT%H%M%S)"
  mv -- "$plist" "$trash"
  printf 'DR menu bar app disabled; launch plist moved to %s\n' "$trash"
else
  printf 'DR menu bar app is not installed. Cached backups were not removed.\n'
fi
