{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://denizlg24.com/schemas/dr/recovery-report-v1.json",
  "title": "DR recovery report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recoveryId",
    "createdAt",
    "updatedAt",
    "profile",
    "snapshotIds",
    "preflight",
    "target",
    "cutover",
    "resourceMetrics",
    "phases",
    "checks",
    "exceptions",
    "result"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recoveryId": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "profile": { "enum": ["pi", "forge", "all"] },
    "snapshotIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localPreflight",
        "profile",
        "iCloudConfirmedSnapshots",
        "oldestSnapshotAgeSeconds",
        "backupArtifactBytes",
        "restoredBytes",
        "imageBytes",
        "requiredTargetDiskBytes",
        "stale",
        "staleAccepted",
        "recoveryToolRevision",
        "recoveryToolDirty",
        "snapshotGitRevisions",
        "localToolVersions",
        "expectedServices",
        "forgeControlPlaneDeployments",
        "cutoverRequested",
        "intendedMutations"
      ],
      "properties": {
        "localPreflight": { "const": "verified" },
        "profile": { "enum": ["pi", "forge", "all"] },
        "iCloudConfirmedSnapshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:pi-cloud|forge)-[0-9]{8}T[0-9]{6}Z$"
          }
        },
        "oldestSnapshotAgeSeconds": { "type": "integer", "minimum": 0 },
        "backupArtifactBytes": { "type": "integer", "minimum": 0 },
        "restoredBytes": { "type": "integer", "minimum": 0 },
        "imageBytes": { "type": "integer", "minimum": 0 },
        "requiredTargetDiskBytes": {
          "type": "integer",
          "minimum": 300000000000
        },
        "stale": { "type": "boolean" },
        "staleAccepted": { "type": "boolean" },
        "recoveryToolRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "recoveryToolDirty": { "type": "boolean" },
        "snapshotGitRevisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        },
        "localToolVersions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["git", "jq", "restic", "ssh", "tar", "zstd"],
          "properties": {
            "git": { "type": "string", "minLength": 1 },
            "jq": { "type": "string", "minLength": 1 },
            "restic": { "type": "string", "minLength": 1 },
            "ssh": { "type": "string", "minLength": 1 },
            "tar": { "type": "string", "minLength": 1 },
            "zstd": { "type": "string", "minLength": 1 }
          }
        },
        "expectedServices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forgeControlPlaneDeployments": {
          "type": "integer",
          "minimum": 1
        },
        "cutoverRequested": { "type": "boolean" },
        "intendedMutations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "fingerprint",
        "os",
        "architecture",
        "vcpu",
        "memoryBytes",
        "diskBytes",
        "storageRotational"
      ],
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^root@(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
        },
        "fingerprint": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "tailnetHost": {
          "type": ["string", "null"],
          "pattern": "^root@100\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "vcpu": { "type": "integer", "minimum": 1 },
        "memoryBytes": { "type": "integer", "minimum": 1 },
        "diskBytes": { "type": "integer", "minimum": 1 },
        "storageRotational": { "const": false }
      }
    },
    "cutover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "performed", "fenced", "reversePatch"],
      "properties": {
        "requested": { "type": "boolean" },
        "performed": { "type": "boolean" },
        "fenced": { "type": "boolean" },
        "reversePatch": { "type": ["string", "null"] }
      }
    },
    "resourceMetrics": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "sampleIntervalSeconds",
        "samples",
        "startedAt",
        "finishedAt",
        "peakCpuPercent",
        "peakLoad1",
        "peakMemoryUsedBytes",
        "minMemoryAvailableBytes",
        "peakDiskUsedBytes",
        "minDiskAvailableBytes",
        "physicalInterfaceCount",
        "physicalNetworkReceiveBytes",
        "physicalNetworkTransmitBytes"
      ],
      "properties": {
        "sampleIntervalSeconds": { "const": 5 },
        "samples": { "type": "integer", "minimum": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "peakCpuPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "peakLoad1": { "type": "number", "minimum": 0 },
        "peakMemoryUsedBytes": { "type": "integer", "minimum": 0 },
        "minMemoryAvailableBytes": { "type": "integer", "minimum": 0 },
        "peakDiskUsedBytes": { "type": "integer", "minimum": 0 },
        "minDiskAvailableBytes": { "type": "integer", "minimum": 0 },
        "physicalInterfaceCount": { "type": "integer", "minimum": 1 },
        "physicalNetworkReceiveBytes": { "type": "integer", "minimum": 0 },
        "physicalNetworkTransmitBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "startedAt", "finishedAt"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["running", "ok", "failed"] },
          "startedAt": { "type": "string", "format": "date-time" },
          "finishedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "detail"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ok", "failed"] },
          "detail": { "type": "string" },
          "evidence": { "type": "object" }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detail"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "result": {
      "enum": [
        "in-progress",
        "verified-no-cutover",
        "recovered",
        "failed",
        "rolled-back"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "enum": ["verified-no-cutover", "recovered", "rolled-back"]
          }
        },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "resourceMetrics": { "type": "object" }
        }
      }
    }
  ]
}
