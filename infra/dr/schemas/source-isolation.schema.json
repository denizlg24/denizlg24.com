{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://denizlg24.com/schemas/dr/source-isolation-v1.json",
  "title": "DR rehearsal source-isolation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verifiedAt",
    "sourcesBlocked",
    "piCloud",
    "forge",
    "publicSourceEndpointsBlocked",
    "verifiedBy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "sourcesBlocked": { "const": true },
    "piCloud": { "$ref": "#/$defs/source" },
    "forge": { "$ref": "#/$defs/source" },
    "publicSourceEndpointsBlocked": { "const": true },
    "verifiedBy": { "type": "string", "minLength": 3 }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["online", "blockedFromTarget", "evidence"],
      "properties": {
        "online": { "const": true },
        "blockedFromTarget": { "const": true },
        "evidence": { "type": "string", "minLength": 8 }
      }
    }
  }
}
