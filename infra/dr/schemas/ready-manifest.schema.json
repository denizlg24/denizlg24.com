{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://denizlg24.com/schemas/dr/ready-manifest-v1.json",
  "title": "DR host READY manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "createdAt",
    "snapshotId",
    "host",
    "profile",
    "generation",
    "resticSnapshotId",
    "forgeControlPlaneSha256",
    "snapshotManifest",
    "objects"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "snapshotId": {
      "type": "string",
      "pattern": "^(?:pi-cloud|forge)-[0-9]{8}T[0-9]{6}Z$"
    },
    "host": { "enum": ["pi-cloud", "forge"] },
    "profile": { "enum": ["pi", "forge"] },
    "generation": { "type": "string", "pattern": "^[0-9]{4}-Q[1-4]$" },
    "resticSnapshotId": { "type": "string", "pattern": "^[0-9a-f]{8,64}$" },
    "forgeControlPlaneSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshotManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "snapshot-manifest.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?:config|data/[0-9a-f]{2}/[0-9a-f]{64}|(?:index|keys|snapshots)/[0-9a-f]{64})$"
          },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "host": { "const": "pi-cloud" } } },
      "then": {
        "properties": {
          "profile": { "const": "pi" },
          "snapshotId": {
            "type": "string",
            "pattern": "^pi-cloud-[0-9]{8}T[0-9]{6}Z$"
          }
        }
      },
      "else": {
        "properties": {
          "profile": { "const": "forge" },
          "snapshotId": {
            "type": "string",
            "pattern": "^forge-[0-9]{8}T[0-9]{6}Z$"
          }
        }
      }
    }
  ]
}
