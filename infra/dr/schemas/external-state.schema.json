{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://denizlg24.com/schemas/dr/external-state-v1.json",
  "title": "DR external-state contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "activeSites",
    "records",
    "preCutoverHealthUrls",
    "healthUrls",
    "tlsEndpoints",
    "betterStackMonitorIds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "activeSites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pi", "forge"],
      "properties": {
        "pi": { "$ref": "#/$defs/activeSite" },
        "forge": { "$ref": "#/$defs/activeSite" }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "type",
          "kind",
          "profiles",
          "publicHostnames",
          "expectedHomeContent",
          "ttl",
          "proxied"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["A", "CNAME"] },
          "kind": { "enum": ["tunnel", "database"] },
          "profiles": { "$ref": "#/$defs/profiles" },
          "publicHostnames": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
            }
          },
          "expectedHomeContent": { "type": "string", "minLength": 1 },
          "ttl": { "type": "integer", "maximum": 60, "minimum": 1 },
          "proxied": { "type": "boolean" }
        }
      }
    },
    "healthUrls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "profiles"],
        "properties": {
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "profiles": { "$ref": "#/$defs/profiles" }
        }
      }
    },
    "preCutoverHealthUrls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "profiles"],
        "properties": {
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "profiles": { "$ref": "#/$defs/profiles" }
        }
      }
    },
    "tlsEndpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "port", "profiles"],
        "properties": {
          "host": { "type": "string", "minLength": 1 },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "profiles": { "$ref": "#/$defs/profiles" }
        }
      }
    },
    "betterStackMonitorIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "profiles"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "profiles": { "$ref": "#/$defs/profiles" }
        }
      }
    }
  },
  "$defs": {
    "activeSite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "name", "expectedHomeContent", "drContent"],
      "properties": {
        "recordId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "expectedHomeContent": { "const": "home" },
        "drContent": { "const": "dr" }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["pi", "forge"] }
    }
  }
}
