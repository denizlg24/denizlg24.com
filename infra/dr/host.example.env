# Install as /etc/deniz-dr/pi.env or /etc/deniz-dr/forge.env, mode 0600.
# For Forge, replace every pi-specific credential filename below with forge and
# use DR_ACTIVE_SITE_RECORD=_active-site-forge.denizlg24.com.
DR_HOST_ENV_FILE=/etc/deniz-dr/pi.env
DR_RESTIC_PASSWORD_FILE=/etc/deniz-dr/pi-restic-password
DR_SIGNING_KEY=/etc/deniz-dr/pi-signing-key
DR_ACTIVE_SITE_RECORD=_active-site-pi.denizlg24.com
DR_ACTIVE_SITE_VALUE=home
DR_HOST_HEARTBEAT_URL=
DR_BACKUP_SUCCESS_HEARTBEAT_URL=
# Optional override. When empty, backup appends /fail to the success URL so a
# failed run opens an incident immediately instead of waiting for staleness.
DR_BACKUP_FAILURE_HEARTBEAT_URL=

# Reviewed production deployment cardinality. Both hosts use this: Pi binds the
# exact PostgreSQL rows and Forge binds the immutable image/environment set.
DR_EXPECTED_FORGE_DEPLOYMENTS=14

# Forge only: environment containing CONTROL_PLANE_URL and AGENT_TOKEN.
DR_FORGE_AGENT_ENV=/etc/forge/agent.env

# Offsite configuration is installed separately as /etc/deniz-dr/r2.env.
# It contains R2_ENDPOINT, R2_BUCKET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# and DR_R2_SYNC_HEARTBEAT_URL. The R2 heartbeat includes retention health.
# install-host derives /etc/deniz-dr/allowed_signers from this host's signing key.
# DR_R2_MAX_DELETE_PERCENT=25  # explicitly reviewed range: 1..50
