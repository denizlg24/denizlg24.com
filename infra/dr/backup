  rm -rf -- "$destination"
}

forge_images() {
  local output="$stage/meta/images.json" agent_env="${DR_FORGE_AGENT_ENV:-/etc/forge/agent.env}"
  local api_url token curl_config response expected_deployments="${DR_EXPECTED_FORGE_DEPLOYMENTS:-}"
  [[ "$expected_deployments" =~ ^[1-9][0-9]*$ ]] || dr_die "DR_EXPECTED_FORGE_DEPLOYMENTS must be a reviewed positive count"
  [[ -f "$agent_env" && ! -L "$agent_env" ]] || dr_die "Forge agent environment is missing"
  api_url="$(awk -F= '$1 == "CONTROL_PLANE_URL" {sub(/^[^=]*=/, ""); print; exit}' "$agent_env")"
  token="$(awk -F= '$1 == "AGENT_TOKEN" {sub(/^[^=]*=/, ""); print; exit}' "$agent_env")"
  [[ "$api_url" =~ ^https?://[A-Za-z0-9._-]+(:[1-9][0-9]{0,4})?$ &&
     ${#token} -ge 32 && "$token" != *[$'\r\n"\\']* ]] \
    || dr_die "Forge recovery inventory credentials are invalid"
  curl_config="$stage/meta/forge-inventory.curl"
  printf 'url = "%s/api/deploy/agent/recovery/inventory"\nheader = "Authorization: Bearer %s"\nfail-with-body\nsilent\nshow-error\nmax-time = 30\n' \
    "$api_url" "$token" > "$curl_config"
  response="$(curl --config "$curl_config")"
  rm -f -- "$curl_config"
  jq -e --argjson baseline "$expected_deployments" '
    .expected == $baseline and
    (.expected == (.images | length)) and
    ([.images[].deploymentId] | unique | length) == .expected and
    all(.images[];
      .recoverable == true and
      (.reference | test("^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$")) and
      (.digest | test("^sha256:[0-9a-f]{64}$")) and
      (.reference | endswith("@" + .digest))
      and .platform=="linux/amd64" and
      (.imageSizeBytes | type=="number" and .>0 and floor==.) and
      (.environmentHmacSha256 | type=="string" and test("^[0-9a-f]{64}$")) and
      (.environmentCipher | type=="object" and
        (.encrypted|type=="string" and length>0) and
        (.iv|type=="string" and length>0) and
        (.authTag|type=="string" and length>0)) and
      (.domain | type=="string" and test("^[A-Za-z0-9.-]+$") and contains("."))
    )
  ' <<< "$response" >/dev/null || dr_die "one or more live Forge deployments lack an immutable recovery artifact"
  jq '[.images[] | {service,deploymentId,reference,digest,platform,domain,imageSizeBytes,environmentHmacSha256,environmentCipher}] | sort_by(.deploymentId)' \
    <<< "$response" > "$output"
  jq '[.images[] | {deploymentId,imageReference:.reference,imageDigest:.digest,hostname:.domain}] | sort_by(.deploymentId)' \
    <<< "$response" > "$stage/meta/forge-control-plane.json"
  jq '[group_by(.reference)[] | .[0].imageSizeBytes] | add // 0' "$output" > "$stage/meta/forge-image-bytes"
}

record_compose_images() {
  local scope="$1" env_file="$2" compose_file="$3" output="$4" service container image_id reference size architecture manifest_list compose_model
  local -a compose_command=(docker compose)
  [[ -z "$env_file" ]] || compose_command+=(--env-file "$env_file")
  compose_command+=(-f "$compose_file")
  compose_model="$("${compose_command[@]}" config --format json)"
  jq -e '.services | type=="object" and length>0' <<< "$compose_model" >/dev/null \
    || dr_die "Compose image model is empty: ${scope}"
  : > "$output"
  while IFS= read -r service; do
    [[ "$service" =~ ^[a-zA-Z0-9_-]+$ ]] || dr_die "unsafe Compose service name: ${service}"
    container="$("${compose_command[@]}" ps --all -q "$service")"
    [[ "$container" =~ ^[0-9a-f]{64}$ ]] || dr_die "Compose service has no unique created container: ${scope}/${service}"
    image_id="$(docker inspect -f '{{.Image}}' "$container")"
    reference="$(docker image inspect -f '{{json .RepoDigests}}' "$image_id" | jq -er '.[0] | select(test("@sha256:[0-9a-f]{64}$"))')" \
      || dr_die "Compose service lacks a registry digest: ${scope}/${service}"
    manifest_list="$(docker buildx imagetools inspect "$reference" --raw)" \
      || dr_die "could not inspect recovery platforms: ${scope}/${service}"
    jq -e '[.manifests[]?.platform | select(.os=="linux") | .architecture] | unique |
      (index("amd64") != null and index("arm64") != null)' <<< "$manifest_list" >/dev/null \
      || dr_die "recovery image is not published for both amd64 and arm64: ${scope}/${service}"
    size="$(docker image inspect -f '{{.Size}}' "$image_id")"
    architecture="$(docker image inspect -f '{{.Architecture}}' "$image_id")"
    [[ "$size" =~ ^[0-9]+$ && "$architecture" =~ ^(amd64|arm64)$ ]] || dr_die "invalid image metadata: ${scope}/${service}"
    jq -cn --arg service "${scope}/${service}" --arg reference "$reference" \
      --arg digest "${reference##*@}" --arg platform "linux/${architecture}" --argjson imageSizeBytes "$size" \
      '{service:$service,reference:$reference,digest:$digest,platform:$platform,imageSizeBytes:$imageSizeBytes}' >> "$output"
  # Profile-gated admin tools are intentionally disposable and are not started
  # by recovery. Every service in the default Compose model must have an exact
  # created container and a multi-architecture registry digest.
  done < <(jq -r '.services | to_entries[] | select((.value.profiles // []) | length==0) | .key' <<< "$compose_model")
  [[ -s "$output" ]] || dr_die "Compose image inventory is empty: ${scope}"
}

pi_images() {
