    namespace*) class=namespace; order=40; verifier=posix-namespace-restore-verify.sh ;;
    config*) class=config; order=5; verifier=config-contract ;;
    *) dr_die "unclassified staged artifact: ${name}" ;;
  esac
  jq -cn --arg class "$class" --arg path "$relative" --arg sha "$(dr_sha256 "$artifact")" \
    --arg verifier "$verifier" --argjson bytes "$(stat -f '%z' "$artifact" 2>/dev/null || stat -c '%s' "$artifact")" \
    --argjson order "$order" '{class:$class,path:$path,sha256:$sha,bytes:$bytes,restoreOrder:$order,verifier:$verifier}'
done | jq -s 'sort_by(.restoreOrder,.path)' > "$artifacts_json"

artifact_bytes="$(jq '[.[].bytes] | add // 0' "$artifacts_json")"
restore_footprint="$stage/meta/restore-footprint.json"
jq -s 'sort_by(.component)' "$restore_footprint_rows" > "$restore_footprint"
rm -f -- "$restore_footprint_rows"
jq -e 'length>=2 and ([.[].component]|unique|length)==length and all(.[]; .bytes>=0 and (.bytes|floor)==.bytes)' \
  "$restore_footprint" >/dev/null || dr_die "restore-footprint evidence is incomplete or duplicated"
restored_bytes="$(jq '[.[].bytes] | add // 0' "$restore_footprint")"
nutrition_captured=false
[[ "$profile" != pi || ! -d /opt/nutrition-api || -L /opt/nutrition-api ]] || nutrition_captured=true
if [[ "$profile" == forge ]]; then
  image_bytes="$(cat "$stage/meta/forge-image-bytes")"
else
  image_bytes="$(cat "$stage/meta/pi-image-bytes")"
fi
file_count="$(find "$stage/artifacts" -type f | wc -l | tr -d ' ')"

jq -n \
  --arg snapshotId "$snapshot_id" --arg createdAt "$(date -u +%FT%TZ)" --arg host "$host_name" \
  --arg profile "$profile" --arg generation "$generation" --arg gitRevision "$git_revision" \
  --arg versionLockSha256 "$version_lock_sha256" \
  --arg forgeControlPlaneSha256 "$forge_control_plane_sha256" \
  --argjson nutritionCaptured "$nutrition_captured" \
  --argjson databaseVersions "$database_versions" \
  --slurpfile artifacts "$artifacts_json" --slurpfile images "$stage/meta/images.json" \
  --slurpfile forgeControlPlane "$stage/meta/forge-control-plane.json" \
  --slurpfile restoreFootprint "$restore_footprint" \
  --argjson artifactBytes "$artifact_bytes" --argjson restoredBytes "$restored_bytes" \
  --argjson imageBytes "$image_bytes" --argjson fileCount "$file_count" \
  '{schemaVersion:1,snapshotId:$snapshotId,createdAt:$createdAt,host:$host,profile:$profile,generation:$generation,
    gitRevision:$gitRevision,versionLockSha256:$versionLockSha256,databaseVersions:$databaseVersions,
    artifacts:$artifacts[0],images:$images[0],forgeControlPlane:$forgeControlPlane[0],
    forgeControlPlaneSha256:$forgeControlPlaneSha256,
    restoreFootprint:$restoreFootprint[0],
    inventory:{authoritative:(if $profile=="pi" then (["postgres","mongodb","redis","namespace-ssd","namespace-hdd","project-object-store","cloud-config","samba-principals","relay-config"] + (if $nutritionCaptured then ["nutrition-config"] else [] end)) else ["forge-control-state","forge-config","forge-images"] end),derived:(if $profile=="pi" then ["meilisearch","mongot"] else ["forge-builds","forge-buildkit-cache","forge-cache","forge-logs"] end),disposable:(if $profile=="pi" then ["docker-socket","proc-sys-rootfs-views","mongot-secrets-volume","partial-uploads","generated-archives"] else ["docker-runtime","forge-agent-staging"] end),unclassifiedWritable:[]},
    totals:{artifactBytes:$artifactBytes,restoredBytes:$restoredBytes,imageBytes:$imageBytes,fileCount:$fileCount}}' \
  > "$stage/snapshot-manifest.json"

dr_validate_json "${script_dir}/schemas/snapshot-manifest.schema.json" "$stage/snapshot-manifest.json"
jq -e '
  .totals.artifactBytes==([.artifacts[].bytes]|add // 0) and
  .totals.restoredBytes==([.restoreFootprint[].bytes]|add // 0) and
  .totals.fileCount==(.artifacts|length) and
  .totals.imageBytes==([.images | group_by(.reference)[] | .[0].imageSizeBytes]|add // 0) and
  ([.artifacts[].path]|unique|length)==(.artifacts|length) and
  ([.restoreFootprint[].component]|unique|length)==(.restoreFootprint|length) and
  (if .profile=="pi" then
    ([.restoreFootprint[] | [.component,.method]]|sort)==[
      ["config","uncompressed-tar"],
      ["mongodb","allocated-verified-restore"],
      ["namespace","allocated-source-inventory"],
      ["postgresql","allocated-verified-restore"],
      ["recovery-host","uncompressed-tar"],
      ["redis","max-memory-rdb"],
      ["samba","restored-files"]
    ]
   else
    ([.restoreFootprint[] | [.component,.method]]|sort)==[
      ["config","uncompressed-tar"],
      ["recovery-host","uncompressed-tar"]
    ]
   end) and
  ([.images[] | [.service,.deploymentId // ""]]|unique|length)==(.images|length) and
  ([.forgeControlPlane[].deploymentId]|unique|length)==(.forgeControlPlane|length) and
  (if .profile=="forge" then
    (.forgeControlPlane == ([.images[] | {deploymentId,imageReference:.reference,imageDigest:.digest,hostname:.domain}] | sort_by(.deploymentId)))
   else true end)
' "$stage/snapshot-manifest.json" >/dev/null || dr_die "snapshot manifest totals or inventories are inconsistent"
if [[ -n ${DR_SECRET_CANARY:-} ]] && grep -Fq -- "$DR_SECRET_CANARY" "$stage/snapshot-manifest.json"; then
  dr_die "secret canary leaked into the snapshot manifest"
fi

export RESTIC_REPOSITORY="$repository" RESTIC_PASSWORD_FILE="$password_file"
if [[ ! -f "$repository/config" ]]; then restic init >/dev/null; fi
backup_json="$(mktemp "${staging_root}/restic-backup.XXXXXX.json")"
(cd "$stage" && restic backup --json --host "$host_name" --tag "dr-${profile}" --tag "$generation" .) > "$backup_json"
restic_snapshot_id="$(jq -rs '[.[] | select(.message_type=="summary")][-1].snapshot_id // empty' "$backup_json")"
rm -f -- "$backup_json"
[[ "$restic_snapshot_id" =~ ^[0-9a-f]+$ ]] || dr_die "restic did not return a snapshot id"

restic forget --host "$host_name" --tag "dr-${profile}" --keep-within 14d --keep-daily 90 --keep-monthly 12 --prune >/dev/null
restic check >/dev/null

objects_json="$stage/meta/repository-objects.json"
find "$repository" -type f ! -path '*/locks/*' ! -name '*.tmp' -print0 | sort -z \
  | while IFS= read -r -d '' object; do
      relative="${object#"$repository"/}"
      dr_assert_restic_object_path "$relative"
      jq -cn --arg path "$relative" --arg sha "$(dr_sha256 "$object")" \
        --argjson bytes "$(stat -f '%z' "$object" 2>/dev/null || stat -c '%s' "$object")" \
        '{path:$path,bytes:$bytes,sha256:$sha}'
    done | jq -s . > "$objects_json"
[[ "$(jq length "$objects_json")" -gt 0 ]] || dr_die "repository object inventory is empty"

ready="$ready_root/${snapshot_id}.json"
[[ ! -e "$ready" && ! -L "$ready" && ! -e "${ready}.sig" && ! -L "${ready}.sig" ]] \
  || dr_die "immutable READY manifest already exists: ${snapshot_id}"
jq -n --arg snapshotId "$snapshot_id" --arg createdAt "$(date -u +%FT%TZ)" --arg host "$host_name" \
  --arg profile "$profile" --arg generation "$generation" --arg resticSnapshotId "$restic_snapshot_id" \
  --arg forgeControlPlaneSha256 "$forge_control_plane_sha256" \
  --arg manifestPath "snapshot-manifest.json" --arg manifestSha "$(dr_sha256 "$stage/snapshot-manifest.json")" \
  --slurpfile objects "$objects_json" \
  '{schemaVersion:1,createdAt:$createdAt,snapshotId:$snapshotId,host:$host,profile:$profile,generation:$generation,
    resticSnapshotId:$resticSnapshotId,forgeControlPlaneSha256:$forgeControlPlaneSha256,
    snapshotManifest:{path:$manifestPath,sha256:$manifestSha},objects:$objects[0]}' > "${ready}.tmp"
dr_validate_json "${script_dir}/schemas/ready-manifest.schema.json" "${ready}.tmp"
if [[ -n ${DR_SECRET_CANARY:-} ]] && grep -Fq -- "$DR_SECRET_CANARY" "${ready}.tmp"; then
  dr_die "secret canary leaked into READY"
fi
assert_active_site
# Publish the detached signature first and the signed manifest last. Readers
# discover only *.json, so interruption can leave at most an ignored orphan
# signature, never a newest unsigned READY that blocks an older good backup.
dr_sign_file "$signing_key" deniz-dr-ready "${ready}.tmp" "${ready}.tmp.sig"
mv -- "${ready}.tmp.sig" "${ready}.sig"
mv -- "${ready}.tmp" "$ready"
setfacl -R -m g:deniz-dr:rX,m::rX "$repository" "$ready_root"

jq -n --arg snapshotId "$snapshot_id" --arg host "$host_name" --arg generation "$generation" \
  --arg resticSnapshotId "$restic_snapshot_id" --arg ready "$ready" \
  '{backedUp:true,verified:true,snapshotId:$snapshotId,host:$host,generation:$generation,resticSnapshotId:$resticSnapshotId,readyManifest:$ready}'
