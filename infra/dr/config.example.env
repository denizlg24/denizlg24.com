# Non-secret installation-specific recovery configuration. Copy to a private
# operator path; recover never loads a repository .env file implicitly.
DR_PI_SSH=denizlg24@pi-cloud
DR_FORGE_SSH=denizlg24@forge
DR_REMOTE_ROOT=/var/lib/deniz-dr
DR_LOCAL_CACHE=/Users/operator/Library/Caches/deniz-dr
DR_ICLOUD_ROOT='/Users/operator/Library/Mobile Documents/com~apple~CloudDocs/Server Backups'
DR_ALLOWED_SIGNERS=/Users/operator/.config/deniz-dr/allowed_signers
DR_COMPLETION_SIGNING_KEY=/Users/operator/.config/deniz-dr/completion_signing_key
DR_COMPLETION_SIGNER=mac-bridge
DR_HOST_SIGNER_PI=pi-cloud
DR_HOST_SIGNER_FORGE=forge
DR_BREAK_GLASS_FILE=/Users/operator/.config/deniz-dr/break-glass.env
DR_REPORT_ROOT=/Users/operator/Documents/Recovery Reports
# Search this many recent signed completions per host for a combined compatible pair.
DR_PAIR_CANDIDATE_LIMIT=32
DR_ICLOUD_WARNING_HEARTBEAT_URL=
DR_ICLOUD_CRITICAL_HEARTBEAT_URL=
DR_EXTERNAL_STATE=/Users/operator/.config/deniz-dr/external-state.json
# Atomic, non-secret endpoint override created during cutover and removed after
# rollback. Keep it outside iCloud and use the same path for dr-sync/recovery.
DR_ACTIVE_RECOVERY_OVERRIDE=/Users/operator/.config/deniz-dr/active-recovery.env
# Forge-only recovery calls the surviving Pi control plane over Tailscale.
# DR_RECOVERY_API_URL=http://100.x.y.z:3001
