{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:bootstrap-superuser": "bun --env-file=../../.env scripts/bootstrap-superuser.ts",
    "auth:migrate-users": "bun --env-file=../../.env scripts/migrate-users.ts",
    "cutover:apply-migrations": "bun --env-file=../../.env scripts/apply-migrations.ts",
    "cutover:inventory": "bun --env-file=../../.env scripts/inventory-dependents.ts",
    "cutover:migrate-resources": "bun --env-file=../../.env scripts/migrate-resources.ts",
    "cutover:migrate-s3-legacy": "bun --env-file=../../.env scripts/migrate-s3-legacy.ts",
    "cutover:rekey-disk-metrics": "bun --env-file=../../.env scripts/rekey-disk-metrics.ts",
    "cutover:snapshot": "bun --env-file=../../.env scripts/pre-cutover-snapshot.ts",
    "ops:posix-gate1-peer": "bun scripts/posix-gate1-peer.ts",
    "ops:posix-gate1-probe": "bun scripts/posix-gate1-probe.ts",
    "ops:posix-gate1-slow-client": "bun scripts/posix-gate1-slow-client.ts",
    "ops:posix-inventory": "bun --env-file=../../.env scripts/posix-inventory.ts",
    "ops:posix-manifest-verify": "bun scripts/posix-manifest-verify.ts",
    "ops:tiering-dry-run": "bun --env-file=../../.env scripts/tiering-dry-run.ts",
    "cutover:verify": "bun --env-file=../../.env scripts/migrate-verify.ts",
    "dev": "PORT=3001 bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun && bun build scripts/apply-migrations.ts scripts/posix-gate1-peer.ts scripts/posix-gate1-probe.ts scripts/posix-gate1-slow-client.ts scripts/posix-inventory.ts scripts/posix-manifest-verify.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@opentelemetry/api": "^1.9.1",
    "@repo/cloud-core": "workspace:*",
    "@repo/schemas": "workspace:*",
    "better-auth": "^1.7.1",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "mongodb": "^7.5.0",
    "redis": "^6.2.1",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/ws": "^8.18.1",
    "tus-js-client": "^4.3.1",
    "typescript": "^5.9.3"
  }
}
