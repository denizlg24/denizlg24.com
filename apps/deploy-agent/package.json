{
  "name": "deploy-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env  run --watch src/index.ts",
    "build": "bun --env-file=../../.env build src/index.ts --outdir dist --target bun",
    "build:host": "bun --env-file=../../.env build src/index.ts --compile --target=bun-linux-x64 --outfile dist/forge-agent",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@repo/cloud-core": "workspace:*",
    "@repo/schemas": "workspace:*",
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
