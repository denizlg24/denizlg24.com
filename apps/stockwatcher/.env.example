APP_URL=http://localhost:3013
DENIZ_OIDC_ISSUER=https://api.denizlg24.com/api/auth
DENIZ_OIDC_CLIENT_ID=
DENIZ_OIDC_CLIENT_SECRET=
# Where /account sends people to change their password and two-factor.
# DENIZ_AUTH_APP_URL=https://auth.denizlg24.com
WORKSPACE_ALLOWED_EMAILS=
# Comma-separated Deniz Cloud user ids (OIDC subjects) allowed to open /admin.
# Empty means nobody. Preview sessions are never admins.
STOCKWATCHER_ADMIN_SUBJECTS=

# Forge runtime settings
DATABASE_URL=
REQUIRE_DATABASE_URL=0
STOCKWATCHER_DB_PATH=.data/stockwatcher.sqlite
DEMO_MODE=0
ALERT_MONITOR=1
# Background refresh of the alternative-data feeds (congress, 13F, lobbying, …);
# runs on the worker, or in-process where ALERT_MONITOR=1. 0 turns it off.
ALT_WARM=1
SEC_USER_AGENT=Stockwatcher research contact research@denizlg24.com

# Interactive Brokers Flex sync. Tokens are encrypted with a key derived from
# BROKER_SECRET, or from DENIZ_OIDC_CLIENT_SECRET when it is unset.
BROKER_SECRET=
BROKER_SYNC=1

# AI assistant, daily brief and memory through Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5.5
AI_GATEWAY_BRIEF_MODEL=
AI_GATEWAY_TEAM_ID=
# Allow AI in preview (demo) sessions
DEMO_AI=0

# Live quotes through the denizlg24.com markets relay (shared signing secret)
MARKETS_RELAY_URL=wss://markets-ws.denizlg24.com
MARKETS_RELAY_TOKEN_SECRET=
# Security functions (DES, ANR, HDS, ERN, MGMT, RELS, MOST, ECO) call the same
# relay over HTTP. Defaults: the https origin of MARKETS_RELAY_URL and the
# token secret; set these when the relay uses a separate MARKETS_DATA_TOKEN.
MARKETS_DATA_URL=
MARKETS_DATA_TOKEN=

# Alert notifications. Email goes through Resend; the sender domain must be
# verified there. Other channels (WhatsApp via CallMeBot, Telegram, Discord,
# Slack, ntfy, webhooks) are configured per user in the app and stored
# encrypted with BROKER_SECRET.
RESEND_API_KEY=
ALERT_EMAIL_FROM=Stockwatcher <alerts@auth.denizlg24.com>

# Credits. BILLING=1 meters the assistant, brief and filing reads against a
# per-user Postgres ledger (needs DATABASE_URL). 1 credit = $0.01 charged;
# charge = gateway cost x CREDIT_MARKUP. Free credits reset monthly.
BILLING=0
CREDIT_MARKUP=2
FREE_CREDITS_MONTHLY=100
CHAT_RESERVE_CREDITS=5
CREDIT_FLOOR=1

# Polar (credit packs). Products come from scripts/polar-setup.ts.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ENVIRONMENT=sandbox
# Per-user AI Gateway keys (plan 035 phase 3). With both set, a user's first
# credit purchase creates their own gateway key whose budget tracks every
# credit they were ever granted, at cost. A backstop under the ledger.
VERCEL_API_TOKEN=
# Background worker (Dockerfile.worker). 1 on web hands compute runs and
# schedules to the worker through stockwatcher_jobs.
STOCKWATCHER_WORKER=0
WORKER_CONCURRENCY=4
# News wire sources beyond Yahoo (SEC EDGAR, PR Newswire/Business Wire,
# Google News, GDELT need no key). Finnhub company news is used when set.
FINNHUB_API_KEY=
# One-click alert channels (each is offered only when its app is set up).
# Telegram: a bot from @BotFather owned by Stockwatcher; register its webhook
# with scripts/telegram-setup.ts. Discord/Slack: OAuth apps whose redirect is
# APP_URL/api/alerts/connect/{discord,slack}/callback.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Browser push: `bunx web-push generate-vapid-keys`. Rotating them drops every
# browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:geral@oceaninformatix.com
# Alternative data: FEC (api.open.fec.gov) falls back to DEMO_KEY, which allows
# a handful of requests an hour; a free key from api.data.gov lifts that.
FEC_API_KEY=
# Senate LDA (lda.gov) works anonymously at 15 requests a minute; a registered
# key raises that to 120. Sent as `Authorization: Token <key>`.
LDA_API_KEY=

# USPTO Open Data Portal key (free; data.uspto.gov/apis/getting-started) for patent grants and applications. Without it patents.ticker answers 503.
USPTO_API_KEY=
