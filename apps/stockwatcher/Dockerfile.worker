# The worker is one bundled file (scripts/build-worker.ts): node builtins only,
# QuickJS's wasm inlined, no Next. It needs node:sqlite's module to exist, not
# to be used, so the runtime is the same node as the web image.
FROM node:24-alpine AS build
WORKDIR /workspace
COPY --from=oven/bun:1.4.4-alpine /usr/local/bin/bun /usr/local/bin/bun

COPY --parents package.json bun.lock apps/*/package.json packages/*/package.json ./
RUN bun install --frozen-lockfile --ignore-scripts

COPY apps/stockwatcher apps/stockwatcher
RUN cd apps/stockwatcher && bun scripts/build-worker.ts

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    ALERT_MONITOR=1
COPY --from=build --chown=node:node /workspace/apps/stockwatcher/dist/worker.mjs ./worker.mjs
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:' + process.env.PORT + '/healthz').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]
CMD ["node", "worker.mjs"]
