EMAIL_CLASSIFIER_API_TOKEN=

# Use one trusted source. A remote model must always have a pinned SHA-256.
EMAIL_CLASSIFIER_MODEL_PATH=
EMAIL_CLASSIFIER_MODEL_S3_ENDPOINT=
EMAIL_CLASSIFIER_MODEL_S3_REGION=eu-west-1
EMAIL_CLASSIFIER_MODEL_S3_ACCESS_KEY_ID=
EMAIL_CLASSIFIER_MODEL_S3_SECRET_ACCESS_KEY=
EMAIL_CLASSIFIER_MODEL_S3_BUCKET=
EMAIL_CLASSIFIER_MODEL_S3_KEY=
EMAIL_CLASSIFIER_MODEL_URL=
EMAIL_CLASSIFIER_MODEL_SHA256=
EMAIL_CLASSIFIER_MODEL_BEARER_TOKEN=
EMAIL_CLASSIFIER_MODEL_VERSION=logistic-regression-v1

# Must remain at or below Vercel's 4.5 MB request limit.
EMAIL_CLASSIFIER_MAX_REQUEST_BYTES=4000000

# Forge only: run one classifier replica with a persistent volume mounted here.
EMAIL_CLASSIFIER_RETRAIN_ENABLED=false
EMAIL_CLASSIFIER_RETRAIN_DIR=/data/email-classifier
# Optional seed paths. Missing default files recover automatically from reviewed
# MongoDB mail; a fresh validation set accumulates after the first recovery run.
EMAIL_CLASSIFIER_TRAIN_PATH=/data/email-classifier/seed/train.jsonl
EMAIL_CLASSIFIER_EVAL_PATH=/data/email-classifier/seed/eval.jsonl
EMAIL_CLASSIFIER_MANIFEST_PATH=/data/email-classifier/seed/manifest.json
# Reuse these two values from the web application's environment.
MONGODB_URI=
RESEND_API_KEY=
