{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "uv sync --frozen --no-dev --no-editable",
  "buildCommand": "true",
  "functions": {
    "main.py": {
      "maxDuration": 300,
      "excludeFiles": "{.data/**,.venv/**,tests/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
