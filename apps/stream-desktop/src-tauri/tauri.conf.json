{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stream",
  "mainBinaryName": "Stream",
  "version": "0.1.0",
  "identifier": "com.denizlg24.stream",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3011"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "url": "https://stream.denizlg24.com",
        "title": "Stream",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0c0b0a",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Entertainment",
    "copyright": "Copyright \u00a9 2026 denizlg24. All rights reserved.",
    "shortDescription": "Films and series for the family",
    "longDescription": "Discover films and series together, keep individual watchlists and progress, and pick up where you left off with shared family profiles.",
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MTQ0MDYyQjdDOTc1RUMKUldUc2RjbTNZa0FVNU94eXhVMWgvNm9JeVFNUDRJUnFjQzFBT0VGWGlxSDMrV0Q1aHlZbUx3akwK",
      "endpoints": [
        "https://github.com/denizlg24/denizlg24.com/releases/download/stream-desktop-latest/latest.json"
      ]
    }
  }
}
