{
  "name": "envoy",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "next dev --webpack --port 3006",
    "build": "prisma generate && next build --webpack",
    "start": "next start --port 3006",
    "lint": "biome check .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "bun test",
    "db:migrate": "bun --env-file=../../.env prisma migrate deploy",
    "db:status": "bun --env-file=../../.env prisma migrate status",
    "storage:migrate:r2": "bun --env-file=../../.env scripts/migrate-r2-to-s3.ts"
  },
  "dependencies": {
    "@repo/schemas": "workspace:*",
    "@repo/ui": "workspace:*",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "7.9.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.0",
    "jose": "^6.2.9",
    "lucide-react": "^1.29.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.20.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.1.18",
    "typescript": "5.9.3"
  }
}
