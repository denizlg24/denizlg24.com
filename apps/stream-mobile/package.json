{
  "name": "stream-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "auth-sdk": "bun run --cwd ../../packages/auth-sdk build",
    "dev": "bun run auth-sdk && expo start",
    "ios": "bun run auth-sdk && expo run:ios",
    "android": "bun run auth-sdk && expo run:android",
    "prebuild": "expo prebuild --clean",
    "bundle": "bun run auth-sdk && expo export --output-dir dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "icons": "bun scripts/render-icons.ts"
  },
  "dependencies": {
    "@denizlg24/auth": "workspace:*",
    "@expo-google-fonts/atkinson-hyperlegible-next": "^0.4.1",
    "@expo-google-fonts/big-shoulders": "^0.4.1",
    "@repo/schemas": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.60.0",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/expo-ios-targets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "^1.4.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  }
}
