#!/bin/sh
# git credential helper: answers `get` for github.com with the run token the
# runner keeps current in /run/creds/github-token. Never stores anything.
set -eu
[ "${1:-}" = "get" ] || exit 0
token_file="${SPRINT_GITHUB_TOKEN_FILE:-/run/creds/github-token}"
host=""
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  [ "$key" = "host" ] && host="$value"
done
[ "$host" = "github.com" ] || exit 0
[ -r "$token_file" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$token_file")"
