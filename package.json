{
  "name": "denizlg24.com",
  "private": true,
  "scripts": {
    "agent-memory:migrate": "cd apps/web && bun --env-file=../../.env scripts/migrate-agent-memory.ts",
    "agent-memory:repair-people": "cd apps/web && bun --env-file=../../.env scripts/migrate-agent-memory-person-identities.ts",
    "papers:migrate": "cd apps/web && bun --env-file=../../.env scripts/migrate-papers-from-notes.ts",
    "build": "bun --env-file=.env turbo run build",
    "build:prod": "bun --env-file=.env.prod turbo run build",
    "cloud:dev:infra": "docker compose --env-file infra/compose/.env.dev -f infra/compose/docker-compose.dev.yml up -d",
    "cloud:dev:infra:down": "docker compose --env-file infra/compose/.env.dev -f infra/compose/docker-compose.dev.yml down",
    "dev": "bun --env-file=.env turbo run dev",
    "dev:web": "bun run markets:relay; bun --env-file=.env turbo run dev --filter=web",
    "dev:desktop": "bun run markets:relay; bun --env-file=.env turbo run dev --filter=web --filter=desktop",
    "markets:relay": "bun scripts/markets-relay-dev.mjs",
    "markets:relay:down": "bun scripts/markets-relay-dev.mjs --down",
    "dev:cloud": "bun run forge:caddy; bun --env-file=.env turbo run dev --filter=api --filter=cloud --filter=deploy-agent",
    "dev:forge": "bun run forge:caddy; bun --env-file=.env turbo run dev --filter=api --filter=forge --filter=deploy-agent",
    "forge:caddy": "bun scripts/forge-caddy-dev.mjs",
    "forge:caddy:down": "bun scripts/forge-caddy-dev.mjs --down",
    "dev:storage": "bun --env-file=.env turbo run dev --filter=api --filter=storage",
    "dev:envoy": "bun --env-file=.env turbo run dev --filter=envoy",
    "lint": "bun --env-file=.env turbo run lint",
    "check-types": "bun --env-file=.env turbo run typecheck",
    "test": "bun --env-file=.env turbo run test",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "postinstall": "node scripts/fetch-tectonic.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "husky": "^9.1.7",
    "knip": "^6.32.0",
    "lint-staged": "^17.3.0",
    "turbo": "^2.10.9",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cmdk": "1.1.1",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
